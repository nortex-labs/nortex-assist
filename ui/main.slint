import { ScrollView, ListView, TextEdit, Palette } from "std-widgets.slint";

export struct ThumbItem { img: image }
export struct HistItem { title: string, sub: string }
// one piece of an answer: kind 0 paragraph, 1 heading, 2 bullet, 3 numbered, 4 quote, 5 code, 6 formula
export struct BlockItem { kind: int, text: string, rich: styled-text, label: string }
export struct FileItem { name: string, info: string, folder: bool }
// One question and its answer in the dialog. `open` false: folded to one line (older turns).
// `action`: a button under an error ("gemini-key", "mic", "settings"), `action-text` its caption.
export struct FeedItem {
    q: string,
    shots: int,
    // names of the files sent with the question
    files: string,
    blocks: [BlockItem],
    note: string,
    error: bool,
    action: string,
    action-text: string,
    open: bool,
    preview: string,
    waiting: bool,
}
// hint of the empty window: keycaps and what they do
export struct HintRow { keys: [string], text: string }
// a hotkey in the settings; `warn` is a soft remark, `bad` makes it red
export struct KeyRow { slot: int, label: string, keys: [string], warn: string, bad: bool }
export struct NewsItem { tag: int, text: string }
export struct NewsVersion { version: string, date: string, items: [NewsItem] }
export struct ActionItem { label: string, prompt: string }
// a button under the answer: kind 0 explain, 1 shorter, 2 translate, 3 own
export struct ActionBtn { label: string, kind: int }

export global Theme {
    in property <bool> dark: true;
    in property <string> accent-name: "violet";
    // the user's own accent (accent-name "custom") and a readable ink on top of it; set from Rust
    in property <color> custom-accent: #8b7cf6;
    in property <color> custom-ink: #ffffff;

    // neutral graphite (dark) and light grey (light); the accent is only for small things
    out property <color> window: dark ? #1b1c20 : #f5f5f7;
    out property <color> surface: dark ? #222328 : #ffffff;
    out property <color> raised: dark ? #2a2b31 : #ebebef;
    out property <color> field: dark ? #25262b : #ffffff;
    out property <color> fg: dark ? #ececf0 : #1c1c21;
    out property <color> muted: dark ? #a3a4ae : #5e5f69;
    out property <color> subtle: dark ? #8a8b95 : #6f707a;
    out property <color> line: dark ? #ffffff12 : #0000001a;
    out property <color> line-strong: dark ? #ffffff22 : #0000002b;
    out property <color> hover: dark ? #ffffff0d : #0000000a;
    out property <color> danger: dark ? #f07a74 : #c9433e;
    out property <color> ok: dark ? #5fcf8e : #23955a;
    out property <color> warn: dark ? #e7b25c : #a86d12;
    out property <color> accent: accent-of(accent-name, dark);
    out property <color> accent-ink: accent-ink-of(accent-name, dark);
    out property <color> accent-soft: accent.with-alpha(dark ? 0.16 : 0.12);
    // accent used for text and small icons: the light theme needs a darker shade to stay readable
    out property <color> accent-text: dark ? accent.brighter(0.12) : accent.darker(0.15);

    public pure function accent-of(name: string, d: bool) -> color {
        if (name == "custom") { return custom-accent; }
        if (name == "blue") { return d ? #6aa2f5 : #2f6fd0; }
        if (name == "green") { return d ? #56c48c : #1f8f57; }
        if (name == "pink") { return d ? #e27bbd : #bf4593; }
        if (name == "orange") { return d ? #eda35e : #bf6b1c; }
        if (name == "red") { return d ? #ee7470 : #c9433e; }
        if (name == "graphite") { return d ? #c4c5cc : #4f5059; }
        return d ? #8f80f7 : #6a57e3;
    }

    pure function accent-ink-of(name: string, d: bool) -> color {
        if (name == "custom") { return custom-ink; }
        if (name == "graphite" && d) { return #1b1c20; }
        return #ffffff;
    }
}

// The one tooltip of the window; drawn on top of everything by MainWindow.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> anchor-h;
}

// Touch area that shows `tip` after the pointer rests on it for a moment.
component TipArea inherits TouchArea {
    in property <string> tip;
    property <bool> done: false;
    changed has-hover => {
        if (!self.has-hover) {
            self.done = false;
            Tip.text = "";
        }
    }
    changed pressed => {
        if (self.pressed) {
            self.done = true;
            Tip.text = "";
        }
    }
    Timer {
        interval: 1200ms;
        running: root.has-hover && !root.done && root.tip != "";
        triggered => {
            root.done = true;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y;
            Tip.anchor-h = root.height;
            Tip.text = root.tip;
        }
    }
}

// Fades in and rises a little when it appears (history, settings, answer area...).
component Panel inherits Rectangle {
    property <bool> shown: false;
    // switched on one frame after creation, so the change is animated (a change in init is not)
    Timer { interval: 16ms; running: !root.shown; triggered => { root.shown = true; } }
    opacity: shown ? 1 : 0;
    animate opacity { duration: 170ms; easing: ease-out; }
    VerticalLayout {
        y: root.shown ? 0px : 6px;
        height: parent.height;
        animate y { duration: 200ms; easing: ease-out; }
        @children
    }
}

// The logo: a rounded accent square with two sparkles.
component Logo inherits Rectangle {
    in property <length> size: 16px;
    width: size;
    height: size;
    border-radius: size * 0.28;
    background: Theme.accent;
    Image {
        source: @image-url("icons/spark.svg");
        width: parent.width;
        height: parent.height;
        colorize: Theme.accent-ink;
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> dot: false;
    in property <string> tip;
    in property <length> icon-size: 16px;
    callback clicked();
    width: 28px;
    height: 28px;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    border-radius: 7px;
    background: !enabled ? transparent : ta.pressed ? Theme.line-strong : active ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 140ms; }
    Image {
        source: root.icon;
        width: ta.pressed ? root.icon-size - 2px : root.icon-size;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: !root.enabled ? Theme.subtle : root.active ? Theme.accent-text : ta.has-hover ? Theme.fg : Theme.muted;
        animate width { duration: 90ms; easing: ease-out; }
        animate colorize { duration: 160ms; }
    }
    // small notification dot (a new option in the settings)
    if root.dot: Rectangle {
        x: parent.width - 9px;
        y: 4px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: Theme.accent;
        border-width: 1.5px;
        border-color: Theme.window;
    }
    ta := TipArea {
        tip: root.tip;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Drawn key ("Alt", "Q", "F8").
component Keycap inherits Rectangle {
    in property <string> text;
    in property <bool> lit: false;
    width: max(24px, kt.preferred-width + 14px);
    height: 22px;
    border-radius: 6px;
    background: lit ? Theme.accent-soft : Theme.raised;
    border-width: 1px;
    border-color: lit ? Theme.accent.with-alpha(0.6) : Theme.line-strong;
    // a slightly thicker bottom edge, like a real key
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 6px;
        border-radius: 1px;
        background: Theme.line;
    }
    kt := Text {
        text: root.text;
        color: root.lit ? Theme.accent-text : Theme.fg;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Keycaps joined with "+".
component KeyCombo inherits HorizontalLayout {
    in property <[string]> keys;
    in property <bool> lit: false;
    spacing: 4px;
    alignment: start;
    for k[i] in root.keys: HorizontalLayout {
        spacing: 4px;
        if i > 0: Text { text: "+"; color: Theme.subtle; font-size: 12px; vertical-alignment: center; }
        Keycap { text: k; lit: root.lit; }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    height: 32px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    width: max(64px, bl.preferred-width + 28px);
    border-radius: 8px;
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.danger.with-alpha(0.6) : ta.has-hover ? Theme.subtle : Theme.line-strong;
    background: !enabled ? transparent
        : primary ? (ta.pressed ? Theme.accent.darker(0.15) : ta.has-hover ? Theme.accent.brighter(0.06) : Theme.accent)
        : (ta.pressed ? Theme.line-strong : ta.has-hover ? Theme.hover : transparent);
    opacity: enabled ? 1 : 0.5;
    animate background, border-color { duration: 140ms; }
    bl := Text {
        text: root.text;
        color: root.primary ? Theme.accent-ink : root.danger ? Theme.danger : Theme.fg;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TipArea {
        tip: root.tip;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Rounded "pill" button under the answer ("Объясни", "Короче"...).
component Pill inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    callback clicked();
    height: 28px;
    width: pl.preferred-width + 20px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    border-radius: 14px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.subtle : Theme.line-strong;
    background: ta.pressed ? Theme.line-strong : ta.has-hover ? Theme.hover : transparent;
    animate background, border-color { duration: 140ms; }
    pl := Text {
        text: root.text;
        color: Theme.fg;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A button under the answer: just a picture; under the pointer it slides open with its word.
// It keeps its own 30px place: the word opens over the neighbours (to the left for the buttons
// on the right edge), so nothing moves away from under the pointer.
component ActionChip inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active: false;
    // false: an active state is shown by colour only (a lasting mode would cover its neighbour)
    in property <bool> open-when-active: true;
    in property <bool> grow-left: false;
    callback clicked();
    property <bool> open: ta.has-hover || (root.active && root.open-when-active);
    property <length> pill-w: root.open ? cl.preferred-width + 40px : 30px;
    width: 30px;
    height: 30px;
    z: root.open ? 2 : 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    pill := Rectangle {
        x: root.grow-left ? root.width - self.width : 0px;
        y: 0px;
        width: root.pill-w;
        height: root.height;
        animate width { duration: 170ms; easing: ease-out; }
        border-radius: 15px;
        background: ta.pressed ? Theme.line-strong : root.open ? Theme.raised : root.active ? Theme.accent-soft : transparent;
        animate background { duration: 140ms; }
        clip: true;
        Image {
            x: root.grow-left ? parent.width - 23px : 7px;
            y: 7px;
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: root.active ? Theme.accent-text : root.open ? Theme.fg : Theme.muted;
            animate colorize { duration: 140ms; }
        }
        cl := Text {
            x: root.grow-left ? 11px : 29px;
            height: parent.height;
            text: root.text;
            color: root.active ? Theme.accent-text : Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
            opacity: root.open ? 1 : 0;
            animate opacity { duration: 150ms; }
        }
    }
    // only the chip's own place reacts, so the neighbour under an opened word stays reachable
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Small text link.
component LinkText inherits Text {
    in property <string> tip;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    color: lta.has-hover ? Theme.fg : Theme.accent-text;
    animate color { duration: 140ms; }
    font-size: 12px;
    lta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// On / off switch.
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    border-radius: 10px;
    background: checked ? Theme.accent : Theme.line-strong;
    animate background { duration: 160ms; }
    Rectangle {
        width: 14px;
        height: 14px;
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        border-radius: 7px;
        background: root.checked ? Theme.accent-ink : Theme.dark ? #d8d8de : #ffffff;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Row of options with a highlight that slides to the chosen one.
component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <[string]> tips;
    in-out property <int> current;
    callback picked(int);
    property <length> seg-w: (self.width - 6px) / max(1, root.items.length);
    height: 32px;
    border-radius: 8px;
    background: Theme.raised;
    Rectangle {
        x: 3px + root.current * root.seg-w;
        y: 3px;
        width: root.seg-w;
        height: parent.height - 6px;
        border-radius: 6px;
        background: Theme.dark ? #3a3b42 : #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000030;
        animate x { duration: 200ms; easing: ease-in-out; }
    }
    for it[i] in root.items: Rectangle {
        x: 3px + i * root.seg-w;
        y: 3px;
        width: root.seg-w;
        height: parent.height - 6px;
        Text {
            text: it;
            font-size: 12px;
            font-weight: i == root.current ? 600 : 400;
            color: i == root.current ? Theme.fg : sta.has-hover ? Theme.fg : Theme.muted;
            animate color { duration: 160ms; }
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: TextOverflow.elide;
        }
        sta := TipArea {
            tip: i < root.tips.length ? root.tips[i] : "";
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.current = i;
                root.picked(i);
            }
        }
    }
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <length> font-size: 13px;
    callback edited();
    callback accepted();
    callback focus-lost();
    public function focus-it() { ti.focus(); }
    height: 32px;
    background: Theme.field;
    border-radius: 8px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : fta.has-hover ? Theme.line-strong : Theme.line;
    animate border-color { duration: 160ms; }
    // Slint matches Ctrl+C/V/X/A by the typed letter, so they die on a Russian layout;
    // handle the Cyrillic keys that sit on the same physical keys, plus Shift+Insert.
    FocusScope {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        capture-key-pressed(e) => {
            if (e.modifiers.control && !e.modifiers.alt) {
                if (e.text == "м" || e.text == "М") { ti.paste(); return accept; }
                if (e.text == "ф" || e.text == "Ф") { ti.select-all(); return accept; }
                if (e.text == "с" || e.text == "С") { ti.copy(); return accept; }
                if (e.text == "ч" || e.text == "Ч") { ti.cut(); return accept; }
            }
            if (e.modifiers.shift && e.text == Key.Insert) { ti.paste(); return accept; }
            return reject;
        }
        // A bare TextInput never scrolls by itself, so a long line (an API key, a model name) ran
        // out of the field. `cursor-position-changed` moves the Flickable to the cursor.
        field-fl := Flickable {
            width: parent.width;
            height: parent.height;
            interactive: false;
            content-width: max(self.width, ti.width);
            content-height: self.height;
            ti := TextInput {
                width: max(field-fl.width, self.preferred-width + 4px);
                height: field-fl.height;
                vertical-alignment: center;
                text <=> root.text;
                input-type: root.password ? InputType.password : InputType.text;
                color: Theme.fg;
                font-size: root.font-size;
                single-line: true;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.fg;
                edited => { root.edited(); }
                accepted => { root.accepted(); }
                changed has-focus => {
                    if (!self.has-focus) { root.focus-lost(); }
                }
                cursor-position-changed(cpos) => {
                    if (cpos.x + field-fl.content-x < 0px) {
                        field-fl.content-x = -cpos.x;
                    } else if (cpos.x + field-fl.content-x > field-fl.width - 2px) {
                        field-fl.content-x = field-fl.width - cpos.x - 2px;
                    }
                }
                changed width => {
                    if (field-fl.content-x < field-fl.width - self.width) {
                        field-fl.content-x = min(0px, field-fl.width - self.width);
                    }
                }
            }
        }
    }
    if root.text == "": Text {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.subtle;
        font-size: root.font-size;
        overflow: TextOverflow.elide;
    }
    fta := TouchArea {
        // let a click anywhere in the frame focus the input
        mouse-cursor: MouseCursor.text;
        clicked => { ti.focus(); }
    }
}

// A hotkey in the settings: drawn keys; a click waits for the new combination.
component KeyCapture inherits Rectangle {
    in property <[string]> keys;
    in property <bool> bad: false;
    callback key(string, bool, bool, bool, bool);
    callback cancelled();
    // waiting for keys starts / ends: the program's own hotkeys are switched off meanwhile,
    // otherwise pressing one of them would run it instead of being recorded
    callback started();
    callback ended();
    height: 30px;
    // one width for every row, so the captions next to the keys line up
    width: max(140px, kc.preferred-width + 16px);
    border-radius: 8px;
    background: fs.has-focus ? Theme.accent-soft : hta.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : root.bad ? Theme.danger : hta.has-hover ? Theme.line-strong : transparent;
    animate background, border-color { duration: 140ms; }
    accessible-role: button;
    accessible-label: @tr("Сменить сочетание клавиш");
    accessible-action-default => { fs.focus(); }
    fs := FocusScope {
        changed has-focus => {
            if (self.has-focus) { root.started(); } else { root.ended(); }
        }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            root.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            return accept;
        }
    }
    kc := KeyCombo {
        x: 8px;
        y: (parent.height - 22px) / 2;
        height: 22px;
        keys: root.keys;
        opacity: fs.has-focus ? 0 : 1;
    }
    if fs.has-focus: Text {
        text: @tr("нажми клавиши…");
        color: Theme.accent-text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hta := TipArea {
        tip: @tr("Нажми, потом нажми новое сочетание.\nEsc — отмена");
        mouse-cursor: MouseCursor.pointer;
        clicked => { fs.focus(); }
    }
}

component OpacitySlider inherits Rectangle {
    in-out property <float> value: 100;
    in property <float> minimum: 10;
    in property <float> maximum: 100;
    callback changed(float);
    height: 20px;
    function apply(x: length) {
        // the knob centre runs from 8px to width - 8px; whole percents only
        root.value = Math.round(Math.clamp(root.minimum + (x - 8px) / (root.width - 16px) * (root.maximum - root.minimum), root.minimum, root.maximum));
        root.changed(root.value);
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.line-strong;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: (root.value - root.minimum) / (root.maximum - root.minimum) * (parent.width - 16px) + 8px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        width: sta.has-hover || sta.pressed ? 16px : 14px;
        height: self.width;
        x: (root.value - root.minimum) / (root.maximum - root.minimum) * (parent.width - 16px) + 8px - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.dark ? #ececf0 : #ffffff;
        border-width: 1px;
        border-color: Theme.line-strong;
        animate width { duration: 120ms; easing: ease-out; }
    }
    sta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.apply(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) { root.apply(self.mouse-x); }
        }
    }
}

// "− 100 % +": steps through a list of values.
component Stepper inherits HorizontalLayout {
    in property <[int]> steps;
    in property <string> unit;
    in-out property <int> index;
    callback changed(int);
    spacing: 2px;
    alignment: end;
    IconButton {
        icon: @image-url("icons/l-chevron-left.svg");
        enabled: root.index > 0;
        clicked => {
            root.index = Math.max(0, root.index - 1);
            root.changed(root.index);
        }
    }
    Text {
        text: (root.index < root.steps.length ? root.steps[root.index] : 0) + root.unit;
        min-width: 52px;
        color: Theme.fg;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconButton {
        icon: @image-url("icons/l-chevron-right.svg");
        enabled: root.index < root.steps.length - 1;
        clicked => {
            root.index = Math.min(root.steps.length - 1, root.index + 1);
            root.changed(root.index);
        }
    }
}

// Palette for the user's own accent colour: saturation/brightness square, hue strip, HEX/RGB field.
component AccentPicker inherits VerticalLayout {
    in-out property <float> h;
    in-out property <float> s;
    in-out property <float> v;
    in-out property <string> text;
    callback picked(color);
    callback text-edited(string);
    spacing: 10px;
    padding-top: 4px;

    Rectangle {
        height: 110px;
        Rectangle {
            border-radius: 8px;
            clip: true;
            background: hsv(root.h, 1, 1);
            Rectangle { background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
        }
        Rectangle {
            width: 14px;
            height: 14px;
            x: root.s * parent.width - 7px;
            y: (1 - root.v) * parent.height - 7px;
            border-radius: 7px;
            border-width: 2px;
            border-color: #ffffff;
            background: hsv(root.h, root.s, root.v);
        }
        TouchArea {
            mouse-cursor: MouseCursor.crosshair;
            function apply() {
                root.s = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.v = 1 - Math.clamp(self.mouse-y / self.height, 0, 1);
                root.picked(hsv(root.h, root.s, root.v));
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.apply(); }
            }
            moved => { if (self.pressed) { self.apply(); } }
        }
    }
    Rectangle {
        height: 12px;
        Rectangle {
            border-radius: 6px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.66%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.66%, #ff00ff 83.33%, #ff0000 100%);
        }
        Rectangle {
            width: 14px;
            height: 14px;
            x: root.h / 360 * (parent.width - 12px) + 6px - 7px;
            y: -1px;
            border-radius: 7px;
            border-width: 2px;
            border-color: #ffffff;
            background: hsv(root.h, 1, 1);
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            function apply() {
                root.h = Math.clamp((self.mouse-x - 6px) / (self.width - 12px), 0, 1) * 359.9;
                root.picked(hsv(root.h, root.s, root.v));
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.apply(); }
            }
            moved => { if (self.pressed) { self.apply(); } }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 32px;
            border-radius: 8px;
            background: hsv(root.h, root.s, root.v);
            border-width: 1px;
            border-color: Theme.line-strong;
        }
        Field {
            text <=> root.text;
            placeholder: @tr("#8F80F7 или 143, 128, 247");
            edited => { root.text-edited(self.text); }
            accepted => { root.text-edited(self.text); }
        }
    }
}

// "Copy" icon of a code block: turns into a check for a moment after the click.
component CopyIcon inherits Rectangle {
    in property <string> tip: @tr("Копировать");
    callback clicked();
    property <bool> done: false;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: cta.pressed ? Theme.line-strong : cta.has-hover ? Theme.hover : transparent;
    animate background { duration: 140ms; }
    Timer { interval: 1400ms; running: root.done; triggered => { root.done = false; } }
    Image {
        source: root.done ? @image-url("icons/l-check.svg") : @image-url("icons/l-copy.svg");
        width: 15px;
        height: 15px;
        colorize: root.done ? Theme.ok : cta.has-hover ? Theme.fg : Theme.muted;
    }
    cta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.done = true; root.clicked(); }
    }
}

// Small RU / EN switch: the current language is highlighted, a click flips it.
component LangToggle inherits Rectangle {
    in property <bool> en;
    callback clicked();
    width: 64px;
    height: 26px;
    border-radius: 7px;
    background: Theme.raised;
    Rectangle {
        x: root.en ? parent.width / 2 + 1px : 3px;
        y: 3px;
        width: parent.width / 2 - 4px;
        height: parent.height - 6px;
        border-radius: 5px;
        background: Theme.dark ? #3a3b42 : #ffffff;
        animate x { duration: 160ms; easing: ease-out; }
    }
    HorizontalLayout {
        Text { text: "RU"; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; color: root.en ? Theme.muted : Theme.fg; }
        Text { text: "EN"; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; color: root.en ? Theme.fg : Theme.muted; }
    }
    TipArea {
        tip: root.en ? "Switch to Russian" : "Switch to English";
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// One piece of an answer drawn according to its kind.
component AnswerBlock inherits VerticalLayout {
    in property <BlockItem> b;
    in property <float> scale: 1.0;
    in property <bool> first: false;
    callback copy-code(string);
    padding-top: root.b.kind == 1 && !root.first ? 6px : 0px;

    if root.b.kind == 0: StyledText {
        text: root.b.rich;
        default-color: Theme.fg;
        default-font-size: 14px * root.scale;
    }
    if root.b.kind == 1: Text {
        text: root.b.text;
        wrap: TextWrap.word-wrap;
        color: Theme.fg;
        font-weight: 700;
        font-size: (root.b.label == "1" ? 18px : root.b.label == "2" ? 16px : 15px) * root.scale;
    }
    if root.b.kind == 2: HorizontalLayout {
        spacing: 6px;
        padding-left: 2px;
        Rectangle {
            width: 12px;
            Rectangle {
                x: 3px;
                y: 8px * root.scale;
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: Theme.muted;
            }
        }
        StyledText {
            text: root.b.rich;
            default-color: Theme.fg;
            default-font-size: 14px * root.scale;
        }
    }
    if root.b.kind == 3: HorizontalLayout {
        spacing: 4px;
        padding-left: 2px;
        Text {
            text: root.b.label;
            width: 22px * root.scale;
            color: Theme.muted;
            font-size: 14px * root.scale;
            horizontal-alignment: left;
            vertical-alignment: top;
        }
        StyledText {
            text: root.b.rich;
            default-color: Theme.fg;
            default-font-size: 14px * root.scale;
        }
    }
    if root.b.kind == 4: HorizontalLayout {
        spacing: 10px;
        padding-left: 2px;
        Rectangle { width: 3px; border-radius: 1.5px; background: Theme.line-strong; }
        StyledText {
            text: root.b.rich;
            default-color: Theme.muted;
            default-font-size: 14px * root.scale;
        }
    }
    if root.b.kind == 5: Rectangle {
        background: Theme.dark ? #17181c : #f3f3f6;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            padding-bottom: 10px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 4px;
                padding-top: 4px;
                Text {
                    text: root.b.label == "" ? @tr("код") : root.b.label;
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                CopyIcon { tip: @tr("Скопировать этот код"); clicked => { root.copy-code(root.b.text); } }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                TextInput {
                    text: root.b.text;
                    read-only: true;
                    single-line: false;
                    wrap: TextWrap.word-wrap;
                    color: Theme.fg;
                    font-family: "Consolas";
                    font-size: 13px * root.scale;
                    selection-background-color: Theme.accent.with-alpha(0.35);
                    selection-foreground-color: Theme.fg;
                }
            }
        }
    }
    if root.b.kind == 6: Rectangle {
        background: Theme.raised;
        border-radius: 8px;
        HorizontalLayout {
            padding: 8px;
            padding-left: 12px;
            padding-right: 12px;
            Text {
                text: root.b.text;
                wrap: TextWrap.word-wrap;
                color: Theme.fg;
                font-family: "Cambria Math";
                font-size: 17px * root.scale;
                font-italic: true;
            }
        }
    }
}

component Thinking inherits HorizontalLayout {
    in property <length> size: 14px;
    in property <color> color: Theme.muted;
    in property <string> text: @tr("Думаю");
    spacing: 3px;
    alignment: start;
    Text { text: root.text; color: root.color; font-size: root.size; vertical-alignment: center; }
    for i in [0, 1, 2]: Rectangle {
        width: root.size * 0.3;
        height: self.width;
        y: (parent.height - self.height) / 2 + root.size * 0.22;
        border-radius: self.width / 2;
        background: root.color;
        opacity: 0.25 + 0.75 * Math.abs(Math.sin(animation-tick() / 1ms * 0.18deg - i * 50deg));
    }
}

// Live sound level while recording: thin bars, the newest on the right.
component Wave inherits Rectangle {
    in property <[float]> levels;
    in property <color> bar-color: Theme.accent;
    min-height: 24px;
    for l[i] in root.levels: Rectangle {
        x: i * 5px;
        width: 3px;
        height: Math.max(3px, Math.min(1, l) * 22px);
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: root.bar-color;
        animate height { duration: 90ms; }
    }
}

// Pulsing red recording dot.
component RecDot inherits Rectangle {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: #ef4b4b;
    opacity: 0.45 + 0.55 * Math.abs(Math.sin(animation-tick() / 1ms * 0.2deg));
}

// Drop-down list in the colours of the app (the standard one marks the choice with Windows' own
// colour and greys the chosen line out). `short`: what the closed field shows (optional).
component Select inherits Rectangle {
    in property <[string]> model;
    in property <[string]> short;
    in property <length> list-width: 0px;
    in-out property <int> current-index;
    callback selected(int);
    property <string> shown: root.current-index >= 0 && root.current-index < root.short.length ? root.short[root.current-index]
        : root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    height: 32px;
    border-radius: 8px;
    background: sta.pressed ? Theme.line-strong : sta.has-hover ? Theme.hover : Theme.field;
    border-width: 1px;
    border-color: sta.has-hover ? Theme.subtle : Theme.line-strong;
    animate background, border-color { duration: 140ms; }
    accessible-role: combobox;
    accessible-value: root.shown;
    accessible-action-default => { popup.show(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Text { text: root.shown; color: Theme.fg; font-size: 12px; vertical-alignment: center; overflow: TextOverflow.elide; horizontal-stretch: 1; }
        Image {
            source: @image-url("icons/l-chevron-down.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.muted;
        }
    }
    sta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        property <length> w: max(root.width, root.list-width);
        // opens under the field, its right edge on the field's right edge (it stays inside the window)
        x: root.width - self.w;
        y: root.height + 4px;
        width: self.w;
        Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                for it[i] in root.model: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: ita.has-hover ? Theme.hover : i == root.current-index ? Theme.accent-soft : transparent;
                    if i == root.current-index: Rectangle {
                        x: 3px;
                        y: (parent.height - self.height) / 2;
                        width: 3px;
                        height: 14px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                    Text {
                        x: 12px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text: it;
                        color: Theme.fg;
                        font-size: 12px;
                        font-weight: i == root.current-index ? 600 : 400;
                        vertical-alignment: center;
                        overflow: TextOverflow.elide;
                    }
                    ita := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

// Section title in the settings.
component SectionTitle inherits Text {
    color: Theme.fg;
    font-size: 13px;
    font-weight: 600;
}

// Windows-11-style row: a small picture, the name (and at most a couple of words under it) on
// one line each, the control on the right. Fixed height: nothing can run into the next row.
component SettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> sub;
    in property <string> tip;
    in property <bool> last: false;
    height: root.sub != "" ? 50px : 42px;
    // under everything else: it shows the tooltip but never takes a click from the controls
    if root.tip != "": TipArea { tip: root.tip; }
    HorizontalLayout {
        spacing: 10px;
        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.muted;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: root.label; color: Theme.fg; font-size: 13px; overflow: TextOverflow.elide; }
            if root.sub != "": Text { text: root.sub; color: Theme.muted; font-size: 12px; overflow: TextOverflow.elide; }
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout { alignment: center; @children }
        }
    }
    if !root.last: Rectangle { x: 26px; y: parent.height - 1px; width: parent.width - 26px; height: 1px; background: Theme.line; }
}

// A row that opens more below it ("Свой промпт ⌄").
component FoldRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> sub;
    in property <bool> last: false;
    in-out property <bool> open;
    height: root.sub != "" ? 50px : 42px;
    HorizontalLayout {
        spacing: 10px;
        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.muted;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: root.label; color: fta.has-hover ? Theme.accent-text : Theme.fg; font-size: 13px; overflow: TextOverflow.elide; }
            if root.sub != "": Text { text: root.sub; color: Theme.muted; font-size: 12px; overflow: TextOverflow.elide; }
        }
        Image {
            source: @image-url("icons/l-chevron-down.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.muted;
            transform-rotation: root.open ? 180deg : 0deg;
            animate transform-rotation { duration: 180ms; easing: ease-out; }
        }
    }
    if !root.last || root.open: Rectangle { x: 26px; y: parent.height - 1px; width: parent.width - 26px; height: 1px; background: Theme.line; }
    fta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.open = !root.open; }
    }
}

// A block of settings: a small title, then its rows on one card.
component Group inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    Text { text: root.title; color: Theme.muted; font-size: 12px; font-weight: 600; }
    Rectangle {
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            @children
        }
    }
}

// Gemini / Groq choice: a neutral letter badge (no third-party logos), name, one line about it.
component ProviderCard inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <image> logo;
    in property <bool> selected;
    in property <string> tip;
    callback clicked();
    height: 54px;
    // both cards take half of the row whatever their words
    horizontal-stretch: 1;
    preferred-width: 120px;
    min-width: 100px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    border-radius: 10px;
    background: selected ? Theme.accent-soft : pta.has-hover ? Theme.hover : Theme.surface;
    border-width: selected ? 1.5px : 1px;
    border-color: selected ? Theme.accent : Theme.line;
    animate background, border-color { duration: 150ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        Image {
            source: root.logo;
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.fg; font-size: 13px; font-weight: 600; overflow: TextOverflow.elide; }
            Text { text: root.sub; color: Theme.muted; font-size: 12px; overflow: TextOverflow.elide; }
        }
    }
    if root.selected: Rectangle {
        x: parent.width - 20px;
        y: 6px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.accent;
        Image { source: @image-url("icons/l-check.svg"); width: 10px; height: 10px; colorize: Theme.accent-ink; }
    }
    pta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// "Как отвечать": a card with a tiny example of such an answer.
component StyleCard inherits Rectangle {
    in property <string> title;
    in property <string> sample;
    in property <bool> selected;
    in property <string> tip;
    callback clicked();
    height: 64px;
    horizontal-stretch: 1;
    preferred-width: 100px;
    min-width: 80px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    border-radius: 10px;
    background: selected ? Theme.accent-soft : sta.has-hover ? Theme.hover : Theme.surface;
    border-width: selected ? 1.5px : 1px;
    border-color: selected ? Theme.accent : Theme.line;
    animate background, border-color { duration: 150ms; }
    VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 3px;
        alignment: start;
        Text { text: root.title; color: Theme.fg; font-size: 12px; font-weight: 600; overflow: TextOverflow.elide; }
        Text { text: root.sample; color: Theme.muted; font-size: 12px; wrap: TextWrap.word-wrap; overflow: TextOverflow.elide; vertical-stretch: 1; }
    }
    sta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// "Новое" / "Улучшено" / "Исправлено": quiet labels in one style.
component NewsTag inherits Rectangle {
    in property <int> tag;
    width: 76px;
    height: 18px;
    border-radius: 5px;
    background: Theme.raised;
    Text {
        text: root.tag == 0 ? @tr("Новое") : root.tag == 1 ? @tr("Улучшено") : @tr("Исправлено");
        color: root.tag == 0 ? Theme.fg : Theme.muted;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ColorDot inherits Rectangle {
    in property <color> dot-color;
    in property <bool> picked;
    in property <bool> rainbow: false;
    in property <string> tip;
    callback clicked();
    width: 26px;
    height: 26px;
    Rectangle {
        width: dta.has-hover || root.picked ? 24px : 20px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.dot-color;
        border-width: root.picked ? 2px : 0px;
        border-color: Theme.fg;
        animate width { duration: 150ms; easing: ease-out; }
        if root.rainbow: Image { source: @image-url("icons/rainbow.svg"); width: parent.width; height: parent.height; }
    }
    dta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Nortex Assist";
    icon: @image-url("icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    preferred-width: 380px;
    preferred-height: 220px;
    min-width: root.overlay-view ? 1px : root.min-w;
    min-height: root.overlay-view ? 1px : root.min-h;

    in property <string> app-title: "Nortex Assist";
    in property <length> min-w: 300px;
    in property <length> min-h: 180px;
    in property <float> win-opacity: 1.0;
    // false for a moment before the window fades in
    in property <bool> appear-on: true;
    in property <bool> pinned: false;
    // compact, click-through presentation used by the "on top" mode
    in property <bool> overlay-view: false;
    // overlay text size; the overlay window is exactly as big as its text (Rust reads ov-want-*)
    in property <length> ov-font: 16px;
    // how much of the overlay's time is left (1 → 0): the thin bar at its bottom
    in property <float> ov-left: 1.0;
    property <length> ov-pad-x: root.ov-font * 0.9;
    property <length> ov-pad-y: root.ov-font * 0.55;
    property <length> ov-extra: root.thinking ? root.ov-font + 9px : 0px;
    property <length> ov-text-w: Math.min(ov-measure.preferred-width + root.ov-extra + 2px, root.ov-font * 28);
    out property <length> ov-want-w: root.ov-text-w + 2 * root.ov-pad-x + 2px;
    out property <length> ov-want-h: Math.min(ov-wrap.preferred-height, root.ov-font * 1.4 * 8) + 2 * root.ov-pad-y + 2px + 4px;

    // ---- dialog ----
    in property <[FeedItem]> feed;
    // a line shown instead of the dialog ("Выделено: …", "Снимок экрана готов", errors without a question)
    in property <string> status-text;
    // text of the overlay window (the last answer as plain text)
    in property <string> body-text;
    in property <bool> busy;
    in property <bool> thinking;
    in property <string> toast-text;
    in property <bool> has-key: true;
    in property <[HintRow]> hints;
    in property <[ActionBtn]> actions;
    in property <bool> select-mode: false;
    in property <string> select-text;
    in property <float> text-scale: 1.0;
    in property <bool> copy-done;
    // counts up when a new question is added: the dialog scrolls to it
    in property <int> scroll-gen;

    // ---- update strip ----
    in property <bool> update-shown;
    in property <bool> update-busy;
    in property <string> update-text;
    // the strip says "updated to 1.4.0" and offers what's new instead of an update
    in property <bool> news-strip;

    // ---- composer ----
    in property <bool> composer-on;
    in property <string> composer-placeholder;
    in-out property <string> composer-text;
    in property <[ThumbItem]> thumbs;
    in property <[FileItem]> files;
    // voice in the window: recording / turning speech into text
    in property <bool> recording;
    in property <bool> transcribing;
    in property <[float]> rec-levels;
    in property <string> rec-time;
    in property <string> voice-key: "F8";

    // ---- history ----
    in property <bool> history-open;
    in property <[HistItem]> history-items;

    // ---- settings ----
    in property <bool> settings-open;
    in-out property <bool> advanced;
    in property <bool> settings-dot;
    in property <bool> smart-offer;
    in property <bool> smart-explain;
    in property <int> provider-index;
    in-out property <string> api-key;
    in property <string> api-key-placeholder;
    // key check: 0 none, 1 checking, 2 works, 3 problem
    in property <int> key-state;
    in property <string> key-state-text;
    in-out property <int> model-index;
    in-out property <string> model-custom;
    in property <[string]> gemini-models;
    in property <[string]> gemini-models-short;
    in-out property <bool> smart-keys: true;
    in-out property <int> key-mode-index: 0;
    in property <[KeyRow]> main-keys;
    in property <[KeyRow]> extra-keys;
    in property <string> keys-hint;
    // 0 short, 1 with a reason, 2 detailed, -1 own prompt
    in property <int> style-index;
    in-out property <string> prompt-text;
    in-out property <int> theme-index;
    in-out property <float> opacity-pct: 100;
    in property <[int]> text-scales: [85, 100, 115, 130, 150, 175];
    in-out property <int> text-scale-index: 1;
    in-out property <bool> overlay-mode;
    in property <[int]> overlay-fonts: [12, 14, 16, 18, 20, 24, 28, 32];
    in-out property <int> overlay-font-index: 2;
    in-out property <int> shot-mode;
    in-out property <bool> history-enabled;
    in-out property <bool> autostart;
    in-out property <bool> show-tray: true;
    in-out property <bool> auto-update: true;
    in property <string> update-status;
    in property <[ActionItem]> action-items;
    in property <bool> actions-custom;
    in-out property <bool> custom-open: false;
    in-out property <float> custom-h: 250;
    in-out property <float> custom-s: 0.5;
    in-out property <float> custom-v: 0.95;
    in-out property <string> custom-text;
    in-out property <bool> lang-en: false;
    in property <string> version-text;
    in property <string> news-title;
    in property <[NewsVersion]> news;
    in-out property <bool> news-open;
    in-out property <bool> about-open;
    in property <string> settings-note;
    in property <bool> uninstall-open: false;
    in property <int> uninstall-left: 0;

    property <bool> panel-open: root.settings-open || root.history-open;
    // the usual window is low: the empty screen packs itself tighter
    property <bool> low: root.height < 360px;
    property <bool> empty: root.feed.length == 0 && root.status-text == "" && !root.busy;
    property <bool> fold-prompt: false;
    property <bool> fold-keys: false;
    property <bool> fold-actions: false;

    callback submit(string);
    callback stop();
    callback quick-action(int);
    callback retry();
    callback copy-answer();
    callback toggle-select();
    callback copy-code(string);
    callback toggle-turn(int);
    callback turn-action(string);
    callback mic-clicked();
    callback update-now();
    callback update-dismiss();
    callback show-news();
    callback attach-pick(bool);
    callback remove-file(int);
    callback paste-image() -> bool;
    callback remove-image(int);
    callback toggle-history();
    callback history-selected(int);
    callback clear-history();
    callback toggle-settings();
    callback toggle-pin();
    callback hide-window();
    callback escape-pressed();
    callback drag-start();
    callback drag-move();
    callback resize-start();
    callback resize-move();
    // settings
    callback provider-picked(int);
    callback key-edited(string);
    callback key-done();
    callback open-key-link();
    callback model-picked();
    callback key-mode-picked(bool);
    callback offer-try();
    callback offer-later();
    callback explain-done();
    callback hotkey-key(int, string, bool, bool, bool, bool);
    callback hotkey-cancelled();
    callback hotkey-capture(bool);
    callback reset-hotkeys();
    callback style-picked(int);
    callback prompt-saved();
    callback theme-picked(int);
    callback accent-picked(string);
    callback custom-color-picked(color);
    callback custom-text-edited(string);
    callback opacity-changed(float);
    callback text-scale-changed(int);
    callback overlay-changed();
    callback setting-changed();
    callback action-edited(int, string, string);
    callback action-add();
    callback action-remove(int);
    callback actions-reset();
    callback check-updates();
    callback toggle-lang();
    callback exit-app();
    callback uninstall-ask();
    callback uninstall-cancel();
    callback uninstall-confirm();

    public function focus-input() { inp.focus(); }
    public function focus-root() { root-scope.focus(); }
    // std widgets (combo boxes, the prompt editor) follow the app theme, not the Windows one
    public function sync-palette() { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }

    root-scope := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape && (!root.pinned || root.busy || root.recording)) {
                root.escape-pressed();
                return accept;
            }
            return reject;
        }
        capture-key-pressed(e) => {
            if (root.composer-on && !root.settings-open && e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "м" || e.text == "М")) {
                if (root.paste-image()) { return accept; }
            }
            return reject;
        }

        // the whole window fades in and rises a little when it opens
        Rectangle {
            y: root.appear-on ? 0px : 8px;
            height: parent.height;
            opacity: root.win-opacity * (root.appear-on ? 1 : 0);
            animate opacity { duration: root.appear-on ? 160ms : 0ms; easing: ease-out; }
            animate y { duration: root.appear-on ? 200ms : 0ms; easing: ease-out; }
            background: Theme.window;
            border-radius: root.overlay-view ? Math.min(16px, root.ov-font * 0.8) : 14px;
            border-width: 1px;
            border-color: Theme.line-strong;
            clip: true;

            VerticalLayout {
                // ---- title bar: logo, name; history, settings, close. Double click pins the window ----
                Rectangle {
                    visible: !root.overlay-view;
                    height: root.overlay-view ? 0px : 34px;
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.drag-start();
                            }
                        }
                        moved => {
                            if (self.pressed) { root.drag-move(); }
                        }
                        double-clicked => { root.toggle-pin(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Logo { y: (parent.height - self.height) / 2; }
                            Text { text: root.app-title; color: Theme.fg; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton {
                            y: 3px;
                            icon: @image-url("icons/l-pin.svg");
                            active: root.pinned;
                            tip: root.pinned ? @tr("Окно закреплено и не прячется.\nНажми, чтобы открепить") : @tr("Закрепить окно: оно не будет прятаться,\nкогда кликаешь в другое место или жмёшь Esc");
                            clicked => { root.toggle-pin(); }
                        }
                        IconButton {
                            y: 3px;
                            icon: @image-url("icons/l-history.svg");
                            tip: @tr("История");
                            active: root.history-open;
                            clicked => { root.toggle-history(); }
                        }
                        IconButton {
                            y: 3px;
                            icon: @image-url("icons/l-settings.svg");
                            tip: @tr("Настройки");
                            active: root.settings-open;
                            dot: root.settings-dot;
                            clicked => { root.toggle-settings(); }
                        }
                        IconButton {
                            y: 3px;
                            icon: @image-url("icons/l-close.svg");
                            tip: @tr("Спрятать окно (Esc). Программа остаётся в трее.\nДвойной щелчок по полосе — закрепить окно");
                            clicked => { root.hide-window(); }
                        }
                    }
                    // waiting for the answer: a short accent stripe runs along the bottom edge
                    if root.busy: Rectangle {
                        x: 0px;
                        y: parent.height - 2px;
                        width: parent.width;
                        height: 2px;
                        clip: true;
                        Rectangle {
                            property <float> phase: Math.mod(animation-tick() / 1ms, 1400) / 1400;
                            width: parent.width * 0.3;
                            x: (parent.width + self.width) * self.phase - self.width;
                            height: 2px;
                            background: @linear-gradient(90deg, Theme.accent.with-alpha(0) 0%, Theme.accent 50%, Theme.accent.with-alpha(0) 100%);
                        }
                    }
                }

                // ---- "new version" strip ----
                if root.update-shown && !root.overlay-view && !root.settings-open: upd := Rectangle {
                    property <bool> shown: false;
                    Timer { interval: 16ms; running: !upd.shown; triggered => { upd.shown = true; } }
                    height: shown ? 44px : 0px;
                    animate height { duration: 220ms; easing: ease-out; }
                    clip: true;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 6px;
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.line;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 4px;
                                spacing: 4px;
                                Text {
                                    text: root.update-text;
                                    color: Theme.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: TextOverflow.elide;
                                }
                                if root.news-strip: Button {
                                    y: 3px;
                                    height: 30px;
                                    text: @tr("Что нового");
                                    clicked => { root.show-news(); }
                                }
                                if !root.update-busy && !root.news-strip: Button {
                                    y: 3px;
                                    height: 30px;
                                    text: @tr("Обновить");
                                    primary: true;
                                    tip: @tr("Скачать и поставить новую версию.\nПрограмма перезапустится сама,\nнастройки и история сохранятся");
                                    clicked => { root.update-now(); }
                                }
                                if !root.update-busy: IconButton {
                                    y: 4px;
                                    icon: @image-url("icons/l-close.svg");
                                    tip: @tr("Напомнить при следующем запуске");
                                    clicked => { root.update-dismiss(); }
                                }
                            }
                        }
                    }
                }

                // ---- "on top" presentation: just the text, a thin bar shows the time left ----
                if root.overlay-view: Rectangle {
                    vertical-stretch: 1;
                    if !root.thinking: Text {
                        x: root.ov-pad-x + 1px;
                        y: root.ov-pad-y + 1px;
                        width: parent.width - 2 * root.ov-pad-x - 2px;
                        height: parent.height - 2 * root.ov-pad-y - 6px;
                        text: root.body-text;
                        wrap: TextWrap.word-wrap;
                        overflow: TextOverflow.elide;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Theme.fg;
                        font-size: root.ov-font;
                        font-weight: 600;
                    }
                    if root.thinking: HorizontalLayout {
                        alignment: center;
                        Thinking { size: root.ov-font; color: Theme.fg; }
                    }
                    Rectangle {
                        x: root.ov-pad-x;
                        y: parent.height - 7px;
                        width: parent.width - 2 * root.ov-pad-x;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.line;
                        Rectangle {
                            x: 0;
                            width: parent.width * Math.clamp(root.ov-left, 0, 1);
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                            animate width { duration: 130ms; }
                        }
                    }
                }

                // ---- empty window: sparkle, "Спроси что угодно" and the keys ----
                // a low window (the usual one) drops the big sparkle and packs the hints tighter
                if !root.panel-open && !root.overlay-view && root.empty: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: root.low ? 2px : 20px;
                        padding-bottom: root.low ? 2px : 20px;
                        spacing: root.low ? 8px : 14px;
                        if !root.low: HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/spark.svg");
                                width: 44px;
                                height: 44px;
                                colorize: Theme.accent;
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 7px;
                            if root.low: Image {
                                source: @image-url("icons/spark.svg");
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                colorize: Theme.accent;
                            }
                            Text {
                                text: root.has-key ? @tr("Спроси что угодно") : @tr("Добавь ключ, чтобы начать");
                                color: Theme.fg;
                                font-size: root.low ? 14px : 18px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        if !root.has-key: Text {
                            text: @tr("Ключ бесплатный, его выдают Google (Gemini) или Groq. Это займёт минуту.");
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: TextWrap.word-wrap;
                            horizontal-alignment: center;
                        }
                        if !root.has-key: HorizontalLayout {
                            alignment: center;
                            Button { text: @tr("Открыть настройки"); primary: true; clicked => { root.toggle-settings(); } }
                        }
                        if root.has-key: HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                spacing: root.low ? 5px : 10px;
                                for h in root.hints: HorizontalLayout {
                                    spacing: 10px;
                                    KeyCombo { keys: h.keys; width: 84px; }
                                    Text {
                                        text: h.text;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: TextOverflow.elide;
                                        width: min(220px, root.width - 32px - 94px);
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- the dialog: questions as chips on the right, answers under them ----
                if !root.panel-open && !root.overlay-view && !root.empty: Panel {
                    vertical-stretch: 1;
                    feed-sv := ScrollView {
                        vertical-stretch: 1;
                        // how far the content goes: taken from where it really ends (see `feed-end`)
                        property <length> content-end;
                        property <length> last-top;
                        content-height: max(self.visible-height, self.content-end);
                        content-width: self.visible-width;
                        // a new question: bring it to the top of the view
                        changed last-top => {
                            self.content-y = -max(0px, self.last-top - 6px);
                        }
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 6px;
                            padding-bottom: 12px;
                            spacing: 14px;
                            alignment: start;
                            for t[ti] in root.feed: VerticalLayout {
                                spacing: 8px;
                                // the newest question reports where it is, so the view can scroll to it
                                changed y => {
                                    if (ti == root.feed.length - 1) { feed-sv.last-top = self.y; }
                                }
                                init => {
                                    if (ti == root.feed.length - 1) { feed-sv.last-top = self.y; }
                                }
                                // question chip (right), folds the turn when clicked if it is an older one
                                HorizontalLayout {
                                    alignment: end;
                                    Rectangle {
                                        property <length> maxw: (feed-sv.visible-width - 32px) * 0.82;
                                        width: Math.min(qt.preferred-width + 22px, self.maxw);
                                        height: qt.height + 12px;
                                        border-radius: 12px;
                                        background: Theme.raised;
                                        qt := Text {
                                            x: 11px;
                                            y: 6px;
                                            width: parent.width - 22px;
                                            height: Math.min(self.preferred-height, 34px);
                                            text: t.q;
                                            color: Theme.fg;
                                            font-size: 12px;
                                            wrap: TextWrap.word-wrap;
                                            overflow: TextOverflow.elide;
                                        }
                                        if !t.open: TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.toggle-turn(ti); }
                                        }
                                    }
                                }
                                // the files that went with the question
                                if t.files != "": HorizontalLayout {
                                    alignment: end;
                                    spacing: 4px;
                                    Image {
                                        source: @image-url("icons/l-clip.svg");
                                        width: 12px;
                                        height: 12px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Theme.subtle;
                                    }
                                    Text {
                                        text: t.files;
                                        color: Theme.subtle;
                                        font-size: 12px;
                                        overflow: TextOverflow.elide;
                                        max-width: (feed-sv.visible-width - 32px) * 0.82;
                                    }
                                }
                                // an older turn, folded: one line of its answer
                                if !t.open: Rectangle {
                                    height: 22px;
                                    Text {
                                        x: 0;
                                        width: parent.width;
                                        text: t.preview;
                                        color: fold-ta.has-hover ? Theme.fg : Theme.muted;
                                        font-size: 12px;
                                        overflow: TextOverflow.elide;
                                        vertical-alignment: center;
                                    }
                                    fold-ta := TipArea {
                                        tip: @tr("Показать ответ целиком");
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.toggle-turn(ti); }
                                    }
                                }
                                if t.open && t.waiting: Thinking { }
                                if t.open && !t.waiting && root.select-mode && ti == root.feed.length - 1: FocusScope {
                                    capture-key-pressed(e) => {
                                        if (e.modifiers.control && !e.modifiers.alt) {
                                            if (e.text == "с" || e.text == "С") { sel.copy(); return accept; }
                                            if (e.text == "ф" || e.text == "Ф") { sel.select-all(); return accept; }
                                        }
                                        return reject;
                                    }
                                    VerticalLayout {
                                        sel := TextInput {
                                            text: root.select-text;
                                            read-only: true;
                                            single-line: false;
                                            wrap: TextWrap.word-wrap;
                                            color: Theme.fg;
                                            font-size: 14px * root.text-scale;
                                            selection-background-color: Theme.accent.with-alpha(0.35);
                                            selection-foreground-color: Theme.fg;
                                        }
                                    }
                                }
                                if t.open && !t.waiting && !(root.select-mode && ti == root.feed.length - 1): VerticalLayout {
                                    spacing: 9px * root.text-scale;
                                    for b[i] in t.blocks: AnswerBlock {
                                        b: b;
                                        first: i == 0;
                                        scale: root.text-scale;
                                        copy-code(c) => { root.copy-code(c); }
                                    }
                                }
                                // "Ответила Gemini — у Groq кончился лимит"
                                if t.open && t.note != "": Text {
                                    text: t.note;
                                    color: Theme.subtle;
                                    font-size: 12px;
                                    wrap: TextWrap.word-wrap;
                                }
                                if t.open && t.action != "": HorizontalLayout {
                                    alignment: start;
                                    Button { text: t.action-text; clicked => { root.turn-action(t.action); } }
                                }
                                // quick follow-ups under the newest answer: pictures that open into a word
                                if t.open && ti == root.feed.length - 1 && !t.waiting && !root.busy && !t.error: HorizontalLayout {
                                    spacing: 2px;
                                    padding-top: 2px;
                                    for a[ai] in root.actions: ActionChip {
                                        text: a.label;
                                        icon: a.kind == 0 ? @image-url("icons/l-bulb.svg") : a.kind == 1 ? @image-url("icons/l-shorter.svg") : a.kind == 2 ? @image-url("icons/l-globe.svg") : @image-url("icons/l-sparkles.svg");
                                        clicked => { root.quick-action(ai); }
                                    }
                                    ActionChip {
                                        text: @tr("Другой вариант");
                                        icon: @image-url("icons/l-refresh.svg");
                                        clicked => { root.retry(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; min-width: 0px; }
                                    ActionChip {
                                        text: root.copy-done ? @tr("Скопировано") : @tr("Копировать");
                                        icon: root.copy-done ? @image-url("icons/l-check.svg") : @image-url("icons/l-copy.svg");
                                        active: root.copy-done;
                                        grow-left: true;
                                        clicked => { root.copy-answer(); }
                                    }
                                    ActionChip {
                                        text: @tr("Выделить");
                                        icon: @image-url("icons/l-cursor.svg");
                                        active: root.select-mode;
                                        open-when-active: false;
                                        grow-left: true;
                                        clicked => { root.toggle-select(); }
                                    }
                                }
                                // a failed answer can be asked again
                                if t.open && ti == root.feed.length - 1 && !t.waiting && !root.busy && t.error: HorizontalLayout {
                                    alignment: start;
                                    Pill { text: @tr("Повторить"); clicked => { root.retry(); } }
                                }
                            }
                            if root.status-text != "": Text {
                                text: root.status-text;
                                wrap: TextWrap.word-wrap;
                                color: Theme.muted;
                                font-size: 13px;
                            }
                            // Marks the end of the content. A scroll view takes the minimal height of its
                            // content, and Slint measures wrapped text as one line, so a long answer stopped
                            // scrolling early. This marker sits where the content really ends.
                            feed-end := Rectangle {
                                height: 0px;
                                init => { feed-sv.content-end = self.y + 12px; }
                                changed y => { feed-sv.content-end = self.y + 12px; }
                            }
                        }
                    }
                }

                // ---- history ----
                if root.history-open && !root.settings-open: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 14px;
                        padding-top: 6px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text { text: @tr("История"); color: Theme.fg; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.history-items.length > 0: Button {
                                text: hist-armed ? @tr("Удалить всё?") : @tr("Очистить");
                                danger: hist-armed;
                                property <bool> hist-armed: false;
                                tip: @tr("Удаляет со второго нажатия");
                                clicked => {
                                    if (self.hist-armed) {
                                        self.hist-armed = false;
                                        root.clear-history();
                                    } else {
                                        self.hist-armed = true;
                                    }
                                }
                            }
                        }
                        if root.history-items.length == 0: Text { text: @tr("Пока пусто: здесь появятся вопросы и ответы."); color: Theme.muted; font-size: 12px; }
                        ListView {
                            vertical-stretch: 1;
                            for it[i] in root.history-items: Rectangle {
                                height: 52px;
                                background: hta.pressed ? Theme.line-strong : hta.has-hover ? Theme.hover : transparent;
                                animate background { duration: 140ms; }
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 6px;
                                    padding-left: 8px;
                                    spacing: 2px;
                                    Text { text: it.title; color: Theme.fg; font-size: 13px; overflow: TextOverflow.elide; }
                                    Text { text: it.sub; color: Theme.muted; font-size: 12px; overflow: TextOverflow.elide; }
                                }
                                hta := TipArea {
                                    tip: @tr("Открыть ответ; его можно уточнить");
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.history-selected(i); }
                                }
                            }
                        }
                    }
                }

                // ---- settings, in the same window ----
                if root.settings-open: Panel {
                    vertical-stretch: 1;
                    Rectangle {
                        height: 40px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 14px;
                            spacing: 6px;
                            IconButton {
                                y: 6px;
                                icon: @image-url("icons/l-chevron-left.svg");
                                tip: @tr("Назад");
                                clicked => { root.toggle-settings(); }
                            }
                            Text { text: @tr("Настройки"); color: Theme.fg; font-size: 16px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: @tr("Расширенные"); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                            Toggle { y: 10px; checked <=> root.advanced; toggled => { root.setting-changed(); } }
                        }
                    }
                    // a problem with a setting: right under the title, where it is seen
                    if root.settings-note != "": Rectangle {
                        height: note-t.height + 14px;
                        background: Theme.danger.with-alpha(0.12);
                        note-t := Text {
                            x: 14px;
                            y: 7px;
                            width: root.width - 28px;
                            height: self.preferred-height;
                            text: root.settings-note;
                            color: Theme.danger;
                            font-size: 12px;
                            wrap: TextWrap.word-wrap;
                        }
                    }
                    set-sv := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 4px;
                            padding-bottom: 16px;
                            spacing: 10px;
                            alignment: start;

                            // offer of the new key mode to those who updated from 1.3
                            if root.smart-offer: Rectangle {
                                background: Theme.accent-soft;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.4);
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Text { text: @tr("Новое: одна клавиша на всё"); color: Theme.fg; font-size: 13px; font-weight: 600; }
                                    Text {
                                        width: set-sv.visible-width - 28px - 24px;
                                        height: self.preferred-height;
                                        text: @tr("Alt+W сам поймёт, что спросить: выделенный текст или то, что на экране. Ответ приходит сразу.");
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: TextWrap.word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Button { text: @tr("Попробовать"); primary: true; clicked => { root.offer-try(); } }
                                        Button { text: @tr("Не сейчас"); clicked => { root.offer-later(); } }
                                    }
                                }
                            }
                            // after "Попробовать": how the keys work now
                            if root.smart-explain: Rectangle {
                                background: Theme.surface;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.line;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 9px;
                                    Text { text: @tr("Теперь клавиши работают так"); color: Theme.fg; font-size: 13px; font-weight: 600; }
                                    for h in root.hints: HorizontalLayout {
                                        spacing: 10px;
                                        KeyCombo { keys: h.keys; width: 92px; }
                                        Text { text: h.text; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: TextOverflow.elide; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        Button { text: @tr("Понятно"); primary: true; clicked => { root.explain-done(); } }
                                    }
                                }
                            }

                            // ---- Нейросеть ----
                            SectionTitle { text: @tr("Нейросеть"); }
                            HorizontalLayout {
                                spacing: 8px;
                                ProviderCard {
                                    title: "Gemini";
                                    sub: @tr("Умная, видит фото");
                                    tip: @tr("Google Gemini: умная, хорошо понимает картинки");
                                    logo: @image-url("icons/gemini.svg");
                                    selected: root.provider-index == 0;
                                    clicked => { root.provider-picked(0); }
                                }
                                ProviderCard {
                                    title: "Groq";
                                    sub: @tr("Очень быстрая");
                                    tip: @tr("Groq (модель Qwen): отвечает очень быстро");
                                    logo: @image-url("icons/groq.svg");
                                    selected: root.provider-index == 1;
                                    clicked => { root.provider-picked(1); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: @tr("Ключ"); color: Theme.fg; font-size: 12px; vertical-alignment: center; width: 36px; }
                                Field {
                                    password: true;
                                    text <=> root.api-key;
                                    placeholder: root.api-key-placeholder;
                                    edited => { root.key-edited(self.text); }
                                    accepted => { root.key-done(); }
                                    focus-lost => { root.key-done(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                padding-left: 46px;
                                if root.key-state != 0: Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: root.key-state == 2 ? Theme.ok : root.key-state == 3 ? Theme.danger : Theme.subtle;
                                }
                                if root.key-state != 0: Text {
                                    text: root.key-state-text;
                                    color: root.key-state == 2 ? Theme.ok : root.key-state == 3 ? Theme.danger : Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    wrap: TextWrap.word-wrap;
                                    horizontal-stretch: 1;
                                }
                                if root.key-state == 0: Rectangle { horizontal-stretch: 1; }
                                LinkText {
                                    text: @tr("Получить ключ бесплатно ↗");
                                    vertical-alignment: center;
                                    tip: @tr("Откроется сайт, где ключ выдают бесплатно");
                                    clicked => { root.open-key-link(); }
                                }
                            }
                            // ---- Клавиши ----
                            SectionTitle { text: @tr("Клавиши"); }
                            VerticalLayout {
                                spacing: 2px;
                                for k in root.main-keys: VerticalLayout {
                                    HorizontalLayout {
                                        spacing: 8px;
                                        KeyCapture {
                                            keys: k.keys;
                                            bad: k.bad;
                                            key(t, c, a, s, m) => { root.hotkey-key(k.slot, t, c, a, s, m); }
                                            cancelled => { root.hotkey-cancelled(); }
                                            started => { root.hotkey-capture(true); }
                                            ended => { root.hotkey-capture(false); }
                                        }
                                        Text { text: k.label; color: Theme.fg; font-size: 13px; vertical-alignment: center; overflow: TextOverflow.elide; horizontal-stretch: 1; }
                                    }
                                    if k.warn != "": Text {
                                        text: k.warn;
                                        color: k.bad ? Theme.danger : Theme.warn;
                                        font-size: 12px;
                                        overflow: TextOverflow.elide;
                                    }
                                }
                            }

                            if root.keys-hint != "": Text { text: root.keys-hint; color: Theme.muted; font-size: 12px; overflow: TextOverflow.elide; }

                            // ---- Как отвечать ----
                            SectionTitle { text: @tr("Как отвечать"); }
                            HorizontalLayout {
                                spacing: 8px;
                                StyleCard { title: @tr("Коротко"); sample: "x = 5"; selected: root.style-index == 0; tip: @tr("Только ответ, без объяснений"); clicked => { root.style-picked(0); } }
                                StyleCard { title: @tr("С объяснением"); sample: @tr("x = 5 и почему"); selected: root.style-index == 1; tip: @tr("Ответ и пара предложений, почему так"); clicked => { root.style-picked(1); } }
                                StyleCard { title: @tr("Подробно"); sample: @tr("Шаги 1, 2, 3…"); selected: root.style-index == 2; tip: @tr("Решение по шагам. Нейросеть думает дольше"); clicked => { root.style-picked(2); } }
                            }
                            if root.style-index < 0: Text { text: @tr("Сейчас свой промпт — он в «Расширенных»"); color: Theme.muted; font-size: 12px; overflow: TextOverflow.elide; }

                            // ---- Вид ----
                            Group {
                                title: @tr("Вид");
                                SettingRow {
                                    icon: @image-url("icons/l-theme.svg");
                                    label: @tr("Тема");
                                    Segmented {
                                        width: 252px;
                                        items: [@tr("Как в Windows"), @tr("Тёмная"), @tr("Светлая")];
                                        current <=> root.theme-index;
                                        picked(i) => { root.theme-picked(i); }
                                    }
                                }
                                SettingRow {
                                    icon: @image-url("icons/l-palette.svg");
                                    label: @tr("Цвет");
                                    HorizontalLayout {
                                        spacing: 0px;
                                        for name in ["violet", "blue", "green", "pink", "orange", "red", "graphite"]: ColorDot {
                                            dot-color: Theme.accent-of(name, Theme.dark);
                                            picked: Theme.accent-name == name;
                                            clicked => { root.custom-open = false; root.accent-picked(name); }
                                        }
                                        ColorDot {
                                            rainbow: true;
                                            dot-color: transparent;
                                            picked: Theme.accent-name == "custom";
                                            tip: @tr("Свой цвет");
                                            clicked => {
                                                root.custom-open = !root.custom-open;
                                                if (root.custom-open) { root.accent-picked("custom"); }
                                            }
                                        }
                                    }
                                }
                                if root.custom-open: VerticalLayout {
                                    padding-bottom: 10px;
                                    AccentPicker {
                                        h <=> root.custom-h;
                                        s <=> root.custom-s;
                                        v <=> root.custom-v;
                                        text <=> root.custom-text;
                                        picked(c) => { root.custom-color-picked(c); }
                                        text-edited(t) => { root.custom-text-edited(t); }
                                    }
                                }
                                SettingRow {
                                    icon: @image-url("icons/l-drop.svg");
                                    label: @tr("Прозрачность");
                                    HorizontalLayout {
                                        spacing: 8px;
                                        OpacitySlider {
                                            width: 110px;
                                            value <=> root.opacity-pct;
                                            changed(v) => { root.opacity-changed(v); }
                                        }
                                        Text { text: Math.round(root.opacity-pct) + "%"; color: Theme.muted; font-size: 12px; vertical-alignment: center; min-width: 34px; }
                                    }
                                }
                                SettingRow {
                                    icon: @image-url("icons/l-textsize.svg");
                                    label: @tr("Размер текста");
                                    Stepper {
                                        steps: root.text-scales;
                                        unit: " %";
                                        index <=> root.text-scale-index;
                                        changed(i) => { root.text-scale-changed(i); }
                                    }
                                }
                                SettingRow {
                                    icon: @image-url("icons/l-layers.svg");
                                    label: @tr("Поверх окон");
                                    sub: @tr("для игр и видео");
                                    tip: @tr("Короткий ответ в маленьком окне поверх всего.\nОно не забирает фокус и пропускает клики");
                                    last: !root.overlay-mode;
                                    Toggle { checked <=> root.overlay-mode; toggled => { root.overlay-changed(); } }
                                }
                                if root.overlay-mode: SettingRow {
                                    icon: @image-url("icons/l-textsize.svg");
                                    label: @tr("Текст поверх окон");
                                    last: true;
                                    Stepper {
                                        steps: root.overlay-fonts;
                                        unit: " px";
                                        index <=> root.overlay-font-index;
                                        changed(i) => { root.setting-changed(); }
                                    }
                                }
                            }

                            // ---- Расширенные: blocks by what they are for ----
                            if root.advanced: Group {
                                title: @tr("Клавиши");
                                SettingRow {
                                    icon: @image-url("icons/l-keyboard.svg");
                                    label: @tr("Режим");
                                    tip: @tr("Одна на всё: Alt+W сам решает — текст или экран.\nОтдельные: своя клавиша на каждое действие");
                                    Segmented {
                                        width: 200px;
                                        items: [@tr("Одна на всё"), @tr("Отдельные")];
                                        current <=> root.key-mode-index;
                                        picked(i) => { root.key-mode-picked(i == 0); }
                                    }
                                }
                                FoldRow { icon: @image-url("icons/l-keyboard.svg"); label: @tr("Ещё клавиши"); sub: root.smart-keys ? @tr("пометка, повтор") : @tr("повтор запроса"); open <=> root.fold-keys; last: true; }
                                if root.fold-keys: VerticalLayout {
                                    spacing: 2px;
                                    padding-top: 6px;
                                    padding-bottom: 10px;
                                    for k in root.extra-keys: VerticalLayout {
                                        HorizontalLayout {
                                            spacing: 8px;
                                            KeyCapture {
                                                keys: k.keys;
                                                bad: k.bad;
                                                key(t, c, a, s, m) => { root.hotkey-key(k.slot, t, c, a, s, m); }
                                                cancelled => { root.hotkey-cancelled(); }
                                                started => { root.hotkey-capture(true); }
                                                ended => { root.hotkey-capture(false); }
                                            }
                                            Text { text: k.label; color: Theme.fg; font-size: 12px; vertical-alignment: center; overflow: TextOverflow.elide; horizontal-stretch: 1; }
                                        }
                                        if k.warn != "": Text { text: k.warn; color: k.bad ? Theme.danger : Theme.warn; font-size: 12px; overflow: TextOverflow.elide; }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        padding-top: 6px;
                                        Button { text: @tr("Клавиши по умолчанию"); clicked => { root.reset-hotkeys(); } }
                                    }
                                }
                            }
                            if root.advanced: Group {
                                title: @tr("Ответы");
                                if root.provider-index == 0: SettingRow {
                                    icon: @image-url("icons/l-cpu.svg");
                                    label: @tr("Модель");
                                    Select {
                                        width: 180px;
                                        list-width: 250px;
                                        model: root.gemini-models;
                                        short: root.gemini-models-short;
                                        current-index <=> root.model-index;
                                        selected => { root.model-picked(); }
                                    }
                                }
                                if root.provider-index == 0 && root.model-index == root.gemini-models.length - 1: VerticalLayout {
                                    padding-bottom: 8px;
                                    Field {
                                        text <=> root.model-custom;
                                        placeholder: @tr("Например: gemini-3.8-flash");
                                        accepted => { root.model-picked(); }
                                        focus-lost => { root.model-picked(); }
                                    }
                                }
                                if root.provider-index == 1: SettingRow {
                                    icon: @image-url("icons/l-cpu.svg");
                                    label: @tr("Модель");
                                    Text { text: "Qwen 3.8 · 27B"; color: Theme.muted; font-size: 12px; }
                                }
                                FoldRow { icon: @image-url("icons/l-text.svg"); label: @tr("Свой промпт"); sub: @tr("инструкция нейросети"); open <=> root.fold-prompt; }
                                if root.fold-prompt: VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 8px;
                                    padding-bottom: 10px;
                                    FocusScope {
                                        capture-key-pressed(e) => {
                                            if (e.modifiers.control && !e.modifiers.alt) {
                                                if (e.text == "м" || e.text == "М") { pe.paste(); return accept; }
                                                if (e.text == "ф" || e.text == "Ф") { pe.select-all(); return accept; }
                                                if (e.text == "с" || e.text == "С") { pe.copy(); return accept; }
                                                if (e.text == "ч" || e.text == "Ч") { pe.cut(); return accept; }
                                            }
                                            return reject;
                                        }
                                        VerticalLayout {
                                            pe := TextEdit {
                                                height: 110px;
                                                font-size: 12px;
                                                wrap: TextWrap.word-wrap;
                                                text <=> root.prompt-text;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Button { text: @tr("Сохранить"); primary: true; clicked => { root.prompt-saved(); } }
                                        Button { text: @tr("Сбросить"); tip: @tr("Вернуть встроенный промпт «Коротко»"); clicked => { root.style-picked(0); } }
                                    }
                                }
                                FoldRow { icon: @image-url("icons/l-sparkles.svg"); label: @tr("Кнопки под ответом"); sub: @tr("Объясни, Короче…"); open <=> root.fold-actions; last: true; }
                                if root.fold-actions: VerticalLayout {
                                    spacing: 6px;
                                    padding-top: 8px;
                                    padding-bottom: 10px;
                                    for a[ai] in root.action-items: HorizontalLayout {
                                        spacing: 6px;
                                        Field {
                                            width: 96px;
                                            text: a.label;
                                            font-size: 12px;
                                            placeholder: @tr("Подпись");
                                            edited => { root.action-edited(ai, self.text, a.prompt); }
                                        }
                                        Field {
                                            text: a.prompt;
                                            font-size: 12px;
                                            placeholder: @tr("Что попросить");
                                            edited => { root.action-edited(ai, a.label, self.text); }
                                        }
                                        IconButton { y: 2px; icon: @image-url("icons/l-close.svg"); tip: @tr("Убрать кнопку"); clicked => { root.action-remove(ai); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        if root.action-items.length < 3: Button { text: @tr("Добавить"); clicked => { root.action-add(); } }
                                        if root.actions-custom: Button { text: @tr("По умолчанию"); clicked => { root.actions-reset(); } }
                                    }
                                }
                            }
                            if root.advanced: Group {
                                title: @tr("Скриншоты");
                                SettingRow {
                                    icon: @image-url("icons/l-crop.svg");
                                    label: @tr("Способ");
                                    last: true;
                                    tip: @tr("Выделить область: экран замирает, обведи нужное мышью.\nВесь экран: сразу монитор под курсором.\nНожницы: встроенный инструмент Windows");
                                    Select {
                                        width: 170px;
                                        model: [@tr("Выделить область"), @tr("Весь экран"), @tr("Ножницы Windows")];
                                        current-index <=> root.shot-mode;
                                        selected => { root.setting-changed(); }
                                    }
                                }
                            }
                            if root.advanced: Group {
                                title: @tr("Программа");
                                SettingRow {
                                    icon: @image-url("icons/l-history.svg");
                                    label: @tr("Сохранять историю");
                                    sub: @tr("только на этом ПК");
                                    Toggle { checked <=> root.history-enabled; toggled => { root.setting-changed(); } }
                                }
                                SettingRow {
                                    icon: @image-url("icons/l-power.svg");
                                    label: @tr("Запуск с Windows");
                                    Toggle { checked <=> root.autostart; toggled => { root.setting-changed(); } }
                                }
                                SettingRow {
                                    icon: @image-url("icons/l-tray.svg");
                                    label: @tr("Значок в трее");
                                    sub: root.show-tray ? "" : @tr("выход — в «О программе»");
                                    Toggle { checked <=> root.show-tray; toggled => { root.setting-changed(); } }
                                }
                                SettingRow {
                                    icon: @image-url("icons/l-download.svg");
                                    label: @tr("Обновления");
                                    sub: root.update-status;
                                    last: true;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        LinkText { text: @tr("Проверить"); vertical-alignment: center; clicked => { root.check-updates(); } }
                                        Toggle { y: 2px; checked <=> root.auto-update; toggled => { root.setting-changed(); } }
                                    }
                                }
                            }

                            // ---- Что нового ----
                            Rectangle {
                                border-radius: 10px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.line;
                                VerticalLayout {
                                    Rectangle {
                                        height: 40px;
                                        background: nta.has-hover ? Theme.hover : transparent;
                                        border-radius: 10px;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 8px;
                                            Logo { y: (parent.height - self.height) / 2; }
                                            Text { text: root.news-title; color: Theme.fg; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                            Image {
                                                source: root.news-open ? @image-url("icons/l-chevron-down.svg") : @image-url("icons/l-arrow.svg");
                                                width: 14px;
                                                height: 14px;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Theme.muted;
                                                transform-rotation: root.news-open ? 180deg : 0deg;
                                            }
                                        }
                                        nta := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.news-open = !root.news-open; }
                                        }
                                    }
                                    if root.news-open: VerticalLayout {
                                        padding: 12px;
                                        padding-top: 2px;
                                        spacing: 6px;
                                        for v[vi] in root.news: vrow := VerticalLayout {
                                            property <bool> unfolded: vi == 0;
                                            spacing: 6px;
                                            Rectangle {
                                                height: 26px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: v.version; color: Theme.fg; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                                    Text { text: v.date; color: Theme.subtle; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                                    Image {
                                                        source: @image-url("icons/l-chevron-down.svg");
                                                        width: 12px;
                                                        height: 12px;
                                                        y: (parent.height - self.height) / 2;
                                                        colorize: Theme.subtle;
                                                        transform-rotation: vrow.unfolded ? 180deg : 0deg;
                                                    }
                                                }
                                                TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { vrow.unfolded = !vrow.unfolded; }
                                                }
                                            }
                                            if vrow.unfolded: VerticalLayout {
                                                spacing: 6px;
                                                padding-bottom: 6px;
                                                for it in v.items: HorizontalLayout {
                                                    spacing: 8px;
                                                    NewsTag { tag: it.tag; y: 1px; }
                                                    Text {
                                                        width: set-sv.visible-width - 28px - 24px - 76px - 8px;
                                                        height: self.preferred-height;
                                                        text: it.text;
                                                        color: Theme.fg;
                                                        font-size: 12px;
                                                        wrap: TextWrap.word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ---- О программе ----
                            // looks like the other rows that open: a word and an arrow
                            Rectangle {
                                height: 30px;
                                accessible-role: button;
                                accessible-label: @tr("О программе");
                                accessible-action-default => { root.about-open = !root.about-open; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: @tr("О программе");
                                        color: about-ta.has-hover ? Theme.fg : Theme.muted;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Image {
                                        source: @image-url("icons/l-chevron-down.svg");
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: about-ta.has-hover ? Theme.fg : Theme.muted;
                                        transform-rotation: root.about-open ? 180deg : 0deg;
                                        animate transform-rotation { duration: 180ms; easing: ease-out; }
                                    }
                                }
                                about-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.about-open = !root.about-open; }
                                }
                            }
                            if root.about-open: Rectangle {
                                border-radius: 10px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.line;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Logo { size: 28px; }
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "Nortex Assist"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                                            Text { text: root.version-text; color: Theme.muted; font-size: 12px; }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        LangToggle { y: 4px; en: root.lang-en; clicked => { root.toggle-lang(); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Button { text: @tr("Закрыть программу"); tip: @tr("Полностью выйти. Горячие клавиши перестанут работать"); clicked => { root.exit-app(); } }
                                        Button { text: @tr("Удалить программу"); danger: true; tip: @tr("Попросит подтвердить, кнопка включится через 5 секунд"); clicked => { root.uninstall-ask(); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- composer ----
                composer-box := Rectangle {
                    property <bool> shown: root.composer-on && !root.panel-open && !root.overlay-view;
                    // the field is one line and grows with the text (up to about five lines)
                    property <length> field-h: (root.recording || root.transcribing) ? 40px : min(max(40px, inp.preferred-height + 20px), 132px);
                    visible: shown;
                    height: shown ? 10px + self.field-h + (root.thumbs.length > 0 ? 72px : 0px) + (root.files.length > 0 ? 34px : 0px) : 0px;
                    animate height { duration: 160ms; easing: ease-out; }
                    clip: true;
                    VerticalLayout {
                        padding: 8px;
                        padding-top: 2px;
                        spacing: 6px;
                        alignment: end;
                        if root.thumbs.length > 0: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for t[i] in root.thumbs: Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: Theme.line-strong;
                                clip: true;
                                Image { source: t.img; image-fit: ImageFit.cover; width: parent.width; height: parent.height; }
                                Rectangle {
                                    background: #000000;
                                    opacity: tta.has-hover ? 0.55 : 0;
                                    animate opacity { duration: 140ms; }
                                }
                                Image {
                                    source: @image-url("icons/l-close.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #ffffff;
                                    opacity: tta.has-hover ? 1 : 0;
                                    animate opacity { duration: 140ms; }
                                }
                                tta := TipArea {
                                    tip: @tr("Убрать эту картинку");
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.remove-image(i); }
                                }
                            }
                        }
                        if root.files.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            height: 28px;
                            for f[i] in root.files: Rectangle {
                                width: min(fchip.preferred-width + 8px, 190px);
                                height: 28px;
                                border-radius: 8px;
                                background: Theme.raised;
                                fchip := HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Image {
                                        source: f.folder ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                                        width: 13px;
                                        height: 13px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Theme.muted;
                                    }
                                    Text { text: f.name; color: Theme.fg; font-size: 12px; vertical-alignment: center; overflow: TextOverflow.elide; }
                                    if f.info != "": Text { text: f.info; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    Image {
                                        source: @image-url("icons/l-close.svg");
                                        width: 11px;
                                        height: 11px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: fca.has-hover ? Theme.fg : Theme.muted;
                                    }
                                }
                                fca := TipArea {
                                    tip: @tr("Убрать из вопроса");
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.remove-file(i); }
                                }
                            }
                        }
                        Rectangle {
                            height: composer-box.field-h;
                            background: Theme.field;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: inp.has-focus ? Theme.accent.with-alpha(0.7) : Theme.line-strong;
                            animate border-color { duration: 160ms; }
                            HorizontalLayout {
                                padding: 5px;
                                padding-left: 6px;
                                spacing: 4px;
                                // the buttons stay at the bottom edge while the field grows upwards
                                VerticalLayout {
                                    alignment: end;
                                    IconButton {
                                        icon: @image-url("icons/l-clip.svg");
                                        width: 30px;
                                        height: 30px;
                                        tip: @tr("Прикрепить файлы.\nТекст из них попадёт в вопрос");
                                        clicked => { root.attach-pick(false); }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    // voice: recording or turning speech into text, instead of the text
                                    if root.recording || root.transcribing: HorizontalLayout {
                                        spacing: 8px;
                                        padding-left: 4px;
                                        if root.recording: RecDot { y: (parent.height - self.height) / 2; }
                                        if root.recording: Wave { levels: root.rec-levels; horizontal-stretch: 1; }
                                        if root.recording: Text { text: root.rec-time; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                        if root.transcribing: Thinking { text: @tr("Распознаю"); size: 13px; horizontal-stretch: 1; }
                                    }
                                    FocusScope {
                                        visible: !root.recording && !root.transcribing;
                                        width: parent.width;
                                        height: parent.height;
                                        capture-key-pressed(e) => {
                                            if (e.modifiers.control && !e.modifiers.alt) {
                                                if (e.text == "м" || e.text == "М") { inp.paste(); return accept; }
                                                if (e.text == "ф" || e.text == "Ф") { inp.select-all(); return accept; }
                                                if (e.text == "с" || e.text == "С") { inp.copy(); return accept; }
                                                if (e.text == "ч" || e.text == "Ч") { inp.cut(); return accept; }
                                            }
                                            if (e.modifiers.shift && e.text == Key.Insert) { inp.paste(); return accept; }
                                            // Enter sends the question, Shift+Enter starts a new line
                                            if (e.text == Key.Return && !e.modifiers.shift) { root.submit(inp.text); return accept; }
                                            return reject;
                                        }
                                        // The text wraps; a bare TextInput never scrolls by itself, so
                                        // `cursor-position-changed` moves the Flickable to the cursor.
                                        comp-fl := Flickable {
                                            y: -3px;
                                            width: parent.width;
                                            height: parent.height + 6px;
                                            interactive: false;
                                            content-width: self.width;
                                            content-height: inp.height;
                                            inp := TextInput {
                                                width: comp-fl.width;
                                                height: max(comp-fl.height, self.preferred-height);
                                                vertical-alignment: center;
                                                text <=> root.composer-text;
                                                color: Theme.fg;
                                                font-size: 13px;
                                                single-line: false;
                                                wrap: TextWrap.word-wrap;
                                                selection-background-color: Theme.accent.with-alpha(0.35);
                                                selection-foreground-color: Theme.fg;
                                                cursor-position-changed(cpos) => {
                                                    if (cpos.y + comp-fl.content-y < 0px) {
                                                        comp-fl.content-y = -cpos.y;
                                                    } else if (cpos.y + comp-fl.content-y > comp-fl.height - 22px) {
                                                        comp-fl.content-y = comp-fl.height - cpos.y - 22px;
                                                    }
                                                }
                                                changed height => {
                                                    if (comp-fl.content-y < comp-fl.height - self.height) {
                                                        comp-fl.content-y = min(0px, comp-fl.height - self.height);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.composer-text == "" && !root.recording && !root.transcribing: Text {
                                        y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        text: root.composer-placeholder;
                                        color: Theme.subtle;
                                        font-size: 13px;
                                        overflow: TextOverflow.elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: end;
                                    IconButton {
                                        icon: @image-url("icons/l-mic.svg");
                                        width: 30px;
                                        height: 30px;
                                        active: root.recording;
                                        tip: root.recording ? @tr("Закончить запись") : @tr("Сказать голосом: нажми, говори, нажми ещё раз.\nИли зажми ") + root.voice-key + @tr(" в любом месте");
                                        clicked => { root.mic-clicked(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: end;
                                    // send; while an answer is coming it stops it
                                    Rectangle {
                                        property <bool> lit: root.busy || root.composer-text != "" || root.thumbs.length > 0 || root.files.length > 0;
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 15px;
                                        background: !self.lit ? Theme.line-strong : sta.pressed ? Theme.accent.darker(0.15) : sta.has-hover ? Theme.accent.brighter(0.06) : Theme.accent;
                                        animate background { duration: 140ms; }
                                        Image {
                                            source: root.busy ? @image-url("icons/l-stop.svg") : @image-url("icons/l-arrow.svg");
                                            width: root.busy ? 12px : 16px;
                                            height: self.width;
                                            colorize: parent.lit ? Theme.accent-ink : Theme.muted;
                                        }
                                        sta := TipArea {
                                            tip: root.busy ? @tr("Остановить ответ (Esc)") : @tr("Отправить (Enter). Shift+Enter — новая строка.\nCtrl+V в поле вставляет картинку из буфера");
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                if (root.busy) { root.stop(); } else { root.submit(root.composer-text); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // invisible copies of the overlay text, used only to measure it
            ov-measure := Text {
                visible: false;
                text: root.thinking ? @tr("Думаю") : root.body-text;
                font-size: root.ov-font;
                font-weight: 600;
            }
            ov-wrap := Text {
                visible: false;
                width: root.ov-text-w;
                text: root.thinking ? @tr("Думаю") : root.body-text;
                wrap: TextWrap.word-wrap;
                font-size: root.ov-font;
                font-weight: 600;
            }

            // resize grip
            Rectangle {
                visible: !root.overlay-view;
                x: parent.width - 16px;
                y: parent.height - 16px;
                width: 16px;
                height: 16px;
                gta := TipArea {
                    tip: @tr("Потяни, чтобы изменить размер окна");
                    mouse-cursor: MouseCursor.nwse-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.resize-start();
                        }
                    }
                    moved => {
                        if (self.pressed) { root.resize-move(); }
                    }
                }
            }

            // uninstall confirmation: the red button wakes up after five seconds
            if root.uninstall-open && !root.overlay-view: Rectangle {
                background: #000000b0;
                TouchArea { }
                Rectangle {
                    width: min(parent.width - 32px, 340px);
                    height: ucol.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: Theme.surface;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                    ucol := VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text { text: @tr("Удалить Nortex Assist?"); color: Theme.fg; font-size: 15px; font-weight: 600; }
                        Text {
                            text: @tr("Программа, её настройки, ключи API и история будут удалены с этого компьютера. Отменить это нельзя.");
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: TextWrap.word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 6px;
                            alignment: end;
                            Button { text: @tr("Отмена"); primary: true; clicked => { root.uninstall-cancel(); } }
                            Button {
                                text: root.uninstall-left > 0 ? @tr("Удалить (") + root.uninstall-left + ")" : @tr("Удалить");
                                danger: true;
                                enabled: root.uninstall-left == 0;
                                clicked => { root.uninstall-confirm(); }
                            }
                        }
                    }
                }
            }

            // short notice at the bottom ("История очищена", warnings): slides up and fades
            if root.toast-text != "" && !root.overlay-view: toast := Rectangle {
                property <bool> shown: false;
                Timer { interval: 16ms; running: !toast.shown; triggered => { toast.shown = true; } }
                width: min(toast-label.preferred-width + 28px, parent.width - 32px);
                height: toast-label.preferred-height + 16px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - (root.composer-on && !root.panel-open ? composer-box.height + 12px : 16px) + (shown ? 0px : 10px);
                opacity: shown ? 1 : 0;
                animate y, opacity { duration: 200ms; easing: ease-out; }
                background: Theme.raised;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line-strong;
                drop-shadow-blur: 14px;
                drop-shadow-color: #00000060;
                toast-label := Text {
                    x: 14px;
                    y: 8px;
                    width: parent.width - 28px;
                    text: root.toast-text;
                    color: Theme.fg;
                    font-size: 12px;
                    wrap: TextWrap.word-wrap;
                }
            }

            // tooltip: last child, so it is drawn above everything else
            if Tip.text != "" && !root.overlay-view: tipbox := Rectangle {
                property <bool> shown: false;
                Timer { interval: 16ms; running: !tipbox.shown; triggered => { tipbox.shown = true; } }
                width: min(tip-text.preferred-width + 18px, parent.width - 16px);
                height: tip-text.preferred-height + 12px;
                x: max(8px, min(Tip.x, parent.width - self.width - 8px));
                // below the control, or above it when there is no room at the bottom
                property <length> below: Tip.y + Tip.anchor-h + 6px;
                property <bool> flip: self.below + self.height > parent.height - 4px;
                y: (self.flip ? max(4px, Tip.y - self.height - 6px) : self.below) + (shown ? 0px : (self.flip ? 4px : -4px));
                opacity: shown ? 1 : 0;
                animate opacity, y { duration: 150ms; easing: ease-out; }
                background: Theme.raised;
                border-radius: 7px;
                border-width: 1px;
                border-color: Theme.line-strong;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000050;
                tip-text := Text {
                    x: 9px;
                    y: 6px;
                    text: Tip.text;
                    color: Theme.fg;
                    font-size: 12px;
                }
            }
        }
    }
}

// Voice input while the window is closed: a small pill at the bottom of the screen.
export component VoicePill inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Nortex Assist — voice";
    default-font-family: "Segoe UI";
    width: 300px;
    height: 52px;
    in property <[float]> levels;
    in property <string> time-text: "0:00";
    // 0 recording, 1 turning speech into text, 2 a problem (text in `message`)
    in property <int> phase;
    in property <string> message;
    in property <string> hint: @tr("Отпусти — отправлю");
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: self.height / 2;
        background: Theme.dark ? #232429f2 : #fafafcf2;
        border-width: 1px;
        border-color: Theme.line-strong;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 18px;
            spacing: 10px;
            if root.phase == 0: RecDot { y: (parent.height - self.height) / 2; }
            if root.phase == 0: Wave { levels: root.levels; width: 80px; }
            if root.phase == 0: Text { text: root.time-text; color: Theme.fg; font-size: 12px; vertical-alignment: center; }
            if root.phase == 0: Text { text: root.hint; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: TextOverflow.elide; }
            if root.phase == 1: Thinking { text: @tr("Распознаю"); size: 13px; color: Theme.fg; horizontal-stretch: 1; }
            if root.phase == 2: Text { text: root.message; color: Theme.fg; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; wrap: TextWrap.word-wrap; }
        }
    }
}

// Full-screen area picker: the frozen screenshot of the monitor, the user drags a rectangle over it.
export component SnipWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: #000000;
    title: @tr("Nortex Assist — снимок области");
    default-font-family: "Segoe UI";
    forward-focus: fs;

    in property <image> shot;
    in property <float> img-w: 1;
    in property <float> img-h: 1;
    // the selection as fractions of the screen (x, y, width, height); a plain click gives the whole screen
    callback done(float, float, float, float);
    callback cancelled();
    public function grab-focus() { fs.focus(); }

    property <length> ax;
    property <length> ay;
    property <length> bx;
    property <length> by;
    property <bool> dragging: false;
    property <bool> started: false;
    property <length> sx: min(root.ax, root.bx);
    property <length> sy: min(root.ay, root.by);
    property <length> sw: abs(root.bx - root.ax);
    property <length> sh: abs(root.by - root.ay);
    property <bool> intro: false;
    property <color> dim: #000000a6;
    Timer { interval: 16ms; running: !root.intro; triggered => { root.intro = true; } }

    Image { width: parent.width; height: parent.height; source: root.shot; image-fit: fill; }

    // before a selection: the whole screen dims in; during it, four bands leave the selection bright
    if !root.started: Rectangle { background: root.dim; }
    if root.started: Rectangle { x: 0; y: 0; width: parent.width; height: root.sy; background: root.dim; }
    if root.started: Rectangle { x: 0; y: root.sy + root.sh; width: parent.width; height: parent.height - root.sy - root.sh; background: root.dim; }
    if root.started: Rectangle { x: 0; y: root.sy; width: root.sx; height: root.sh; background: root.dim; }
    if root.started: Rectangle { x: root.sx + root.sw; y: root.sy; width: parent.width - root.sx - root.sw; height: root.sh; background: root.dim; }
    if root.started: Rectangle {
        x: root.sx - 1px;
        y: root.sy - 1px;
        width: root.sw + 2px;
        height: root.sh + 2px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 2px;
    }
    // crosshair lines that follow the pointer before dragging
    if !root.dragging && ta.has-hover: Rectangle { x: ta.mouse-x; y: 0; width: 1px; height: parent.height; background: Theme.accent.with-alpha(0.55); }
    if !root.dragging && ta.has-hover: Rectangle { x: 0; y: ta.mouse-y; width: parent.width; height: 1px; background: Theme.accent.with-alpha(0.55); }

    // size of the selection in real pixels
    if root.started: Rectangle {
        x: min(root.sx, parent.width - self.width - 4px);
        y: root.sy > 34px ? root.sy - 30px : min(root.sy + root.sh + 6px, parent.height - self.height - 4px);
        width: size-label.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: #000000c8;
        size-label := Text {
            text: Math.round(root.sw / root.width * root.img-w) + " × " + Math.round(root.sh / root.height * root.img-h);
            color: #ffffff;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // hint at the top; slides down when the picker opens, fades away once the user starts selecting
    Rectangle {
        width: hint.preferred-width + 32px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: root.intro ? 28px : 10px;
        opacity: root.started ? 0 : (root.intro ? 1 : 0);
        animate y { duration: 260ms; easing: ease-out; }
        animate opacity { duration: 200ms; }
        border-radius: 18px;
        background: #1b1c20e6;
        border-width: 1px;
        border-color: #ffffff22;
        hint := Text {
            text: @tr("Выдели область мышью   ·   клик — весь экран   ·   Esc — отмена");
            color: #ececf0;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.crosshair;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.cancelled();
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.ax = self.mouse-x;
                root.ay = self.mouse-y;
                root.bx = root.ax;
                root.by = root.ay;
                root.dragging = true;
                root.started = false;
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                if (root.sw < 6px || root.sh < 6px) {
                    root.done(0, 0, 1, 1);
                } else {
                    root.done(root.sx / root.width, root.sy / root.height, root.sw / root.width, root.sh / root.height);
                }
            }
        }
        moved => {
            if (root.dragging) {
                root.bx = clamp(self.mouse-x, 0px, root.width);
                root.by = clamp(self.mouse-y, 0px, root.height);
                if (abs(root.bx - root.ax) > 3px || abs(root.by - root.ay) > 3px) {
                    root.started = true;
                }
            }
        }
    }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            if (e.text == Key.Return) {
                root.done(0, 0, 1, 1);
                return accept;
            }
            return reject;
        }
    }
}
