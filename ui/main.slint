import { ComboBox, ScrollView, ListView, TextEdit, Palette } from "std-widgets.slint";

export struct ThumbItem { img: image }
export struct HistItem { title: string, sub: string }
// one piece of an answer: kind 0 paragraph, 1 heading, 2 bullet, 3 numbered, 4 quote, 5 code, 6 formula
export struct BlockItem { kind: int, text: string, rich: styled-text, label: string }
export struct FileItem { name: string, info: string, folder: bool }

export global Theme {
    in property <bool> dark: true;
    in property <string> accent-name: "green";
    // the user's own accent (accent-name "custom") and a readable ink on top of it; set from Rust
    in property <color> custom-accent: #4fd1c5;
    in property <color> custom-ink: #151515;

    out property <color> window: dark ? #0e1012 : #f8f9f4;
    out property <color> surface: dark ? #131619 : #ffffff;
    out property <color> raised: dark ? #191d20 : #f2f4ee;
    out property <color> field: dark ? #0c0f10 : #ffffff;
    out property <color> fg: dark ? #f0f2ec : #20251e;
    out property <color> muted: dark ? #8b928c : #72796f;
    out property <color> subtle: dark ? #626a64 : #8c9389;
    out property <color> line: dark ? #e6ede116 : #1a211619;
    out property <color> line-strong: dark ? #e6ede126 : #1a211629;
    out property <color> danger: dark ? #ff8179 : #d65350;
    out property <color> accent: accent-of(accent-name, dark);
    out property <color> accent-ink: accent-ink-of(accent-name);
    out property <color> accent-soft: accent.with-alpha(0.14);
    // accent used for text and small icons: the light theme needs a darker shade to stay readable
    out property <color> accent-text: dark ? accent : accent-text-of(accent-name);

    public pure function accent-of(name: string, d: bool) -> color {
        if (name == "custom") { return custom-accent; }
        if (name == "pink") { return d ? #fa8bc8 : #d94d99; }
        if (name == "blue") { return d ? #84b8ff : #4d83d4; }
        if (name == "red") { return d ? #ff8179 : #d65350; }
        if (name == "orange") { return d ? #ffb26b : #c87827; }
        if (name == "violet") { return d ? #b69bff : #805fc8; }
        return d ? #d3f178 : #a9cd5b;
    }

    pure function accent-ink-of(name: string) -> color {
        if (name == "custom") { return custom-ink; }
        if (name == "pink") { return #24131e; }
        if (name == "blue") { return #101a29; }
        if (name == "red") { return #291312; }
        if (name == "orange") { return #25180d; }
        if (name == "violet") { return #1a1530; }
        return #161b0d;
    }

    pure function accent-text-of(name: string) -> color {
        if (name == "custom") { return custom-accent.darker(0.35); }
        if (name == "pink") { return #b83b80; }
        if (name == "blue") { return #3567b3; }
        if (name == "red") { return #b83c39; }
        if (name == "orange") { return #9a5a17; }
        if (name == "violet") { return #6545ad; }
        return #5f8420;
    }
}

// The one tooltip of the window; drawn on top of everything by MainWindow.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> anchor-h;
}

// Touch area that shows `tip` after the pointer rests on it for a moment.
component TipArea inherits TouchArea {
    in property <string> tip;
    property <bool> done: false;
    changed has-hover => {
        if (!self.has-hover) {
            self.done = false;
            Tip.text = "";
        }
    }
    changed pressed => {
        if (self.pressed) {
            self.done = true;
            Tip.text = "";
        }
    }
    Timer {
        interval: 1500ms;
        running: root.has-hover && !root.done && root.tip != "";
        triggered => {
            root.done = true;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y;
            Tip.anchor-h = root.height;
            Tip.text = root.tip;
        }
    }
}

// Fades in and rises a little when it appears (history, settings, answer area...).
component Panel inherits Rectangle {
    property <bool> shown: false;
    // switched on one frame after creation, so the change is animated (a change in init is not)
    Timer { interval: 16ms; running: !root.shown; triggered => { root.shown = true; } }
    opacity: shown ? 1 : 0;
    animate opacity { duration: 170ms; easing: ease-out; }
    VerticalLayout {
        y: root.shown ? 0px : 8px;
        height: parent.height;
        animate y { duration: 200ms; easing: ease-out; }
        @children
    }
}

// Logo and name in the empty toolbar of a fresh window; fades in.
component Brand inherits HorizontalLayout {
    property <bool> shown: false;
    Timer { interval: 16ms; running: !root.shown; triggered => { root.shown = true; } }
    spacing: 7px;
    padding-left: 4px;
    // the app icon redrawn in the accent colour: a rounded square with a soft gradient and dark sparkles
    Rectangle {
        width: 18px;
        height: 18px;
        y: (parent.height - self.height) / 2;
        // solid accent (rounded corners only work on plain fills) under a light-to-shade sheen picture
        border-radius: 5px;
        background: Theme.accent;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: 200ms; easing: ease-out; }
        Image { source: @image-url("icons/sheen.svg"); width: parent.width; height: parent.height; }
        Image {
            source: @image-url("icons/spark.svg");
            width: parent.width;
            height: parent.height;
            colorize: Theme.accent-ink;
        }
    }
    HorizontalLayout {
        spacing: 4px;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: 200ms; easing: ease-out; }
        Text { text: "Nortex"; color: Theme.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        Text { text: "Assist"; color: Theme.accent-text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: !enabled ? transparent : ta.pressed ? Theme.line-strong : active ? Theme.accent-soft : ta.has-hover ? Theme.line : transparent;
    animate background { duration: 140ms; }
    img := Image {
        source: root.icon;
        // a small "press" squeeze
        width: ta.pressed ? 12px : 14px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: !root.enabled ? Theme.subtle : root.active ? Theme.accent-text : ta.has-hover ? Theme.fg : Theme.muted;
        animate width { duration: 90ms; easing: ease-out; }
        animate colorize { duration: 160ms; }
    }
    ta := TipArea {
        tip: root.tip;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <string> tip;
    callback clicked();
    height: 30px;
    min-width: 70px;
    border-radius: 8px;
    border-width: primary ? 0px : 1px;
    border-color: ta.has-hover ? Theme.muted.with-alpha(0.5) : Theme.line-strong;
    background: primary
        ? (ta.pressed ? Theme.accent.darker(0.2) : ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : (ta.pressed ? Theme.line-strong : ta.has-hover ? Theme.line : transparent);
    animate background, border-color { duration: 140ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: root.primary ? Theme.accent-ink : Theme.fg;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Destructive action: the first click arms it, the second (within 3 s) confirms.
component ConfirmButton inherits Rectangle {
    in property <string> text;
    in property <string> confirm-text: "Точно удалить?";
    callback confirmed();
    property <bool> armed: false;
    height: 30px;
    min-width: 70px;
    border-radius: 8px;
    border-width: 1px;
    border-color: armed ? Theme.danger : ta.has-hover ? Theme.muted.with-alpha(0.5) : Theme.line-strong;
    background: armed ? Theme.danger.with-alpha(0.14) : (ta.has-hover ? Theme.line : transparent);
    animate background, border-color { duration: 160ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.armed ? root.confirm-text : root.text;
            color: root.armed ? Theme.danger : Theme.fg;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 160ms; }
        }
    }
    ta := TipArea {
        tip: "Удаляет со второго нажатия, чтобы не стереть случайно";
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if (root.armed) {
                root.armed = false;
                root.confirmed();
            } else {
                root.armed = true;
            }
        }
    }
    Timer {
        interval: 3s;
        running: root.armed;
        triggered => { root.armed = false; }
    }
}

// Small text link used in the settings.
component LinkText inherits Text {
    in property <string> tip;
    callback clicked();
    color: lta.has-hover ? Theme.fg : Theme.accent-text;
    animate color { duration: 140ms; }
    font-size: 11px;
    lta := TipArea {
        tip: root.tip;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Row of options with a highlight that slides to the chosen one.
component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <[string]> tips;
    in-out property <int> current;
    callback picked(int);
    property <length> seg-w: (self.width - 6px) / max(1, root.items.length);
    height: 32px;
    border-radius: 9px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle {
        x: 3px + root.current * root.seg-w;
        y: 3px;
        width: root.seg-w;
        height: parent.height - 6px;
        border-radius: 7px;
        background: Theme.accent-soft;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.45);
        animate x { duration: 220ms; easing: ease-in-out; }
    }
    for it[i] in root.items: Rectangle {
        x: 3px + i * root.seg-w;
        y: 3px;
        width: root.seg-w;
        height: parent.height - 6px;
        Text {
            text: it;
            font-size: 12px;
            font-weight: i == root.current ? 600 : 400;
            color: i == root.current ? Theme.accent-text : sta.has-hover ? Theme.fg : Theme.muted;
            animate color { duration: 160ms; }
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: TextOverflow.elide;
        }
        sta := TipArea {
            tip: i < root.tips.length ? root.tips[i] : "";
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.current = i;
                root.picked(i);
            }
        }
    }
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    callback edited();
    callback accepted();
    height: 32px;
    background: Theme.field;
    border-radius: 8px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : fta.has-hover ? Theme.line-strong : Theme.line;
    animate border-color { duration: 160ms; }
    // Slint matches Ctrl+C/V/X/A by the typed letter, so they die on a Russian layout;
    // handle the Cyrillic keys that sit on the same physical keys, plus Shift+Insert.
    FocusScope {
        capture-key-pressed(e) => {
            if (e.modifiers.control && !e.modifiers.alt) {
                if (e.text == "м" || e.text == "М") { ti.paste(); return accept; }
                if (e.text == "ф" || e.text == "Ф") { ti.select-all(); return accept; }
                if (e.text == "с" || e.text == "С") { ti.copy(); return accept; }
                if (e.text == "ч" || e.text == "Ч") { ti.cut(); return accept; }
            }
            if (e.modifiers.shift && e.text == Key.Insert) { ti.paste(); return accept; }
            return reject;
        }
        ti := TextInput {
            x: 10px;
            y: 0;
            width: parent.width - 20px;
            height: parent.height;
            vertical-alignment: center;
            text <=> root.text;
            input-type: root.password ? InputType.password : InputType.text;
            color: Theme.fg;
            font-size: 13px;
            single-line: true;
            edited => { root.edited(); }
            accepted => { root.accepted(); }
        }
    }
    if root.text == "": Text {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.subtle;
        font-size: 13px;
        overflow: TextOverflow.elide;
    }
    fta := TouchArea {
        // let a click anywhere in the frame focus the input
        mouse-cursor: MouseCursor.text;
        clicked => { ti.focus(); }
    }
}

component HotkeyField inherits Rectangle {
    in property <string> text;
    callback key(string, bool, bool, bool, bool);
    callback cancelled();
    width: 140px;
    height: 28px;
    background: fs.has-focus ? Theme.accent-soft : Theme.field;
    border-radius: 7px;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : hta.has-hover ? Theme.line-strong : Theme.line;
    animate background, border-color { duration: 160ms; }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            root.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            return accept;
        }
        Text {
            text: fs.has-focus ? "нажми клавиши…" : root.text;
            color: fs.has-focus ? Theme.accent-text : Theme.fg;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    hta := TipArea {
        tip: "Нажми и зажми новое сочетание клавиш.\nEsc — отмена";
        mouse-cursor: MouseCursor.pointer;
        clicked => { fs.focus(); }
    }
}

component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    height: 26px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : cta.has-hover ? Theme.muted : Theme.line-strong;
            background: root.checked ? Theme.accent : Theme.field;
            animate background, border-color { duration: 160ms; }
            Path {
                width: 10px;
                height: 10px;
                x: 3px;
                y: 3px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: "M 2 6 L 5 9 L 10 3";
                stroke: Theme.accent-ink;
                stroke-width: 1.8px;
                opacity: root.checked ? 1 : 0;
                animate opacity { duration: 160ms; }
            }
        }
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    cta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.checked = !root.checked; }
    }
}

component OpacitySlider inherits Rectangle {
    in-out property <float> value: 100;
    in property <float> minimum: 10;
    in property <float> maximum: 100;
    callback changed(float);
    height: 22px;
    function apply(x: length) {
        // the knob centre runs from 8px to width - 8px; whole percents only
        root.value = Math.round(Math.clamp(root.minimum + (x - 8px) / (root.width - 16px) * (root.maximum - root.minimum), root.minimum, root.maximum));
        root.changed(root.value);
    }
    // children of a plain Rectangle are centred unless x is set, hence the explicit x: 0px
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.line-strong;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: (root.value - root.minimum) / (root.maximum - root.minimum) * (parent.width - 16px) + 8px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        // the knob grows under the pointer
        width: sta.has-hover || sta.pressed ? 18px : 16px;
        height: self.width;
        x: (root.value - root.minimum) / (root.maximum - root.minimum) * (parent.width - 16px) + 8px - self.width / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.accent;
        animate width { duration: 120ms; easing: ease-out; }
    }
    sta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.apply(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) { root.apply(self.mouse-x); }
        }
    }
}

// Slider that snaps to fixed steps; every step is marked and labelled ("12 px", "14 px", ...).
component StepSlider inherits Rectangle {
    in property <[int]> steps;
    in property <string> unit: " px";
    in-out property <int> index;
    callback changed(int);
    height: 40px;
    property <length> pad: 16px;
    property <length> span: root.width - 2 * root.pad;
    property <int> last: Math.max(root.steps.length - 1, 1);
    function pos(i: int) -> length {
        return root.pad + root.span * i / root.last;
    }
    function apply(x: length) {
        if (Math.round(Math.clamp((x - root.pad) / root.span * root.last, 0, root.last)) != root.index) {
            root.index = Math.round(Math.clamp((x - root.pad) / root.span * root.last, 0, root.last));
            root.changed(root.index);
        }
    }
    Rectangle {
        x: root.pad;
        y: 9px;
        width: root.span;
        height: 4px;
        border-radius: 2px;
        background: Theme.line-strong;
    }
    Rectangle {
        x: root.pad;
        y: 9px;
        width: root.pos(root.index) - root.pad;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
        animate width { duration: 120ms; easing: ease-out; }
    }
    // one notch per step
    for v[i] in root.steps: Rectangle {
        x: root.pos(i) - 4px;
        y: 7px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: i <= root.index ? Theme.accent : Theme.line-strong;
    }
    for v[i] in root.steps: Text {
        x: root.pos(i) - 24px;
        y: 22px;
        width: 48px;
        horizontal-alignment: center;
        text: v + root.unit;
        font-size: 10px;
        font-weight: i == root.index ? 700 : 400;
        color: i == root.index ? Theme.accent-text : Theme.muted;
    }
    Rectangle {
        width: sta.has-hover || sta.pressed ? 18px : 16px;
        height: self.width;
        x: root.pos(root.index) - self.width / 2;
        y: 11px - self.height / 2;
        border-radius: self.width / 2;
        background: Theme.accent;
        animate x { duration: 120ms; easing: ease-out; }
        animate width { duration: 120ms; easing: ease-out; }
    }
    sta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.apply(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) { root.apply(self.mouse-x); }
        }
    }
}

// What the game-overlay window looks like with a given text size (same paddings and corners).
component OverlaySample inherits Rectangle {
    in property <string> text;
    in property <length> font;
    width: st.preferred-width + 2 * root.font * 0.9 + 2px;
    height: st.preferred-height + 2 * root.font * 0.55 + 2px;
    animate width, height { duration: 120ms; easing: ease-out; }
    background: Theme.window;
    border-radius: Math.min(18px, root.font * 0.8);
    border-width: 1px;
    border-color: Theme.line-strong;
    st := Text {
        text: root.text;
        color: Theme.fg;
        font-size: root.font;
        font-weight: 500;
    }
}

component Card inherits Rectangle {
    in property <string> index;
    in property <string> title;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: root.index; color: Theme.accent-text; font-size: 10px; font-weight: 700; vertical-alignment: center; }
            Text { text: root.title; color: Theme.fg; font-size: 13px; font-weight: 600; }
        }
        @children
    }
}

component Label inherits Text {
    color: Theme.muted;
    font-size: 11px;
}

// Palette for the user's own accent colour: saturation/brightness square, hue strip, HEX/RGB field.
component AccentPicker inherits VerticalLayout {
    in-out property <float> h;
    in-out property <float> s;
    in-out property <float> v;
    in-out property <string> text;
    callback picked(color);
    callback text-edited(string);
    property <bool> shown: false;
    Timer { interval: 16ms; running: !root.shown; triggered => { root.shown = true; } }
    spacing: 10px;
    padding-top: 4px;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease-out; }

    // saturation grows to the right, brightness upwards
    Rectangle {
        height: 120px;
        Rectangle {
            border-radius: 8px;
            clip: true;
            background: hsv(root.h, 1, 1);
            Rectangle { background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%); }
            Rectangle { background: @linear-gradient(180deg, #00000000 0%, #000000 100%); }
        }
        Rectangle {
            width: 14px;
            height: 14px;
            x: root.s * parent.width - 7px;
            y: (1 - root.v) * parent.height - 7px;
            border-radius: 7px;
            border-width: 2px;
            border-color: #ffffff;
            background: hsv(root.h, root.s, root.v);
        }
        TouchArea {
            mouse-cursor: MouseCursor.crosshair;
            function apply() {
                root.s = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.v = 1 - Math.clamp(self.mouse-y / self.height, 0, 1);
                root.picked(hsv(root.h, root.s, root.v));
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.apply(); }
            }
            moved => { if (self.pressed) { self.apply(); } }
        }
    }

    // hue
    Rectangle {
        height: 14px;
        Rectangle {
            border-radius: 7px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.66%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.66%, #ff00ff 83.33%, #ff0000 100%);
        }
        Rectangle {
            width: 16px;
            height: 16px;
            x: root.h / 360 * (parent.width - 14px) + 7px - 8px;
            y: -1px;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ffffff;
            background: hsv(root.h, 1, 1);
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            function apply() {
                root.h = Math.clamp((self.mouse-x - 7px) / (self.width - 14px), 0, 1) * 359.9;
                root.picked(hsv(root.h, root.s, root.v));
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { self.apply(); }
            }
            moved => { if (self.pressed) { self.apply(); } }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 32px;
            border-radius: 8px;
            background: hsv(root.h, root.s, root.v);
            border-width: 1px;
            border-color: Theme.line-strong;
        }
        Field {
            text <=> root.text;
            placeholder: "#4FD1C5 или 79, 209, 197";
            edited => { root.text-edited(self.text); }
            accepted => { root.text-edited(self.text); }
        }
    }
    Label { text: "Двигай по палитре или впиши HEX (#4FD1C5) или RGB (79, 209, 197)."; font-size: 10px; wrap: TextWrap.word-wrap; }
}

// "Думаю" with three softly pulsing dots, shown until the first words of the answer arrive.
// "Copy" chip of a code block: says "Скопировано" for a moment after the click.
component CopyChip inherits Rectangle {
    callback clicked();
    property <bool> done: false;
    width: chip-row.preferred-width + 14px;
    height: 24px;
    border-radius: 7px;
    background: cta.pressed ? Theme.line-strong : cta.has-hover ? Theme.line : transparent;
    animate background { duration: 140ms; }
    Timer { interval: 1500ms; running: root.done; triggered => { root.done = false; } }
    chip-row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 8px;
        spacing: 5px;
        Image {
            source: root.done ? @image-url("icons/check.svg") : @image-url("icons/copy.svg");
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            colorize: root.done ? Theme.accent-text : cta.has-hover ? Theme.fg : Theme.muted;
        }
        Text {
            text: root.done ? "Скопировано" : "Копировать код";
            color: root.done ? Theme.accent-text : cta.has-hover ? Theme.fg : Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    cta := TipArea {
        tip: "Скопировать только этот код";
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.done = true; root.clicked(); }
    }
}

// One piece of an answer drawn according to its kind.
component AnswerBlock inherits VerticalLayout {
    in property <BlockItem> b;
    in property <float> scale: 1.0;
    in property <bool> first: false;
    callback copy-code(string);
    padding-top: root.b.kind == 1 && !root.first ? 8px : 0px;

    if root.b.kind == 0: StyledText {
        text: root.b.rich;
        default-color: Theme.fg;
        default-font-size: 14px * root.scale;
    }
    if root.b.kind == 1: HorizontalLayout {
        spacing: 9px;
        Rectangle { width: 3px; border-radius: 2px; background: Theme.accent; }
        Text {
            text: root.b.text;
            wrap: TextWrap.word-wrap;
            color: Theme.fg;
            font-weight: 700;
            font-size: (root.b.label == "1" ? 19px : root.b.label == "2" ? 17px : 15px) * root.scale;
        }
    }
    if root.b.kind == 2: HorizontalLayout {
        spacing: 6px;
        padding-left: 4px;
        Rectangle {
            width: 12px;
            Rectangle {
                x: 3px;
                y: 8px * root.scale;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
            }
        }
        StyledText {
            text: root.b.rich;
            default-color: Theme.fg;
            default-font-size: 14px * root.scale;
        }
    }
    if root.b.kind == 3: HorizontalLayout {
        spacing: 4px;
        padding-left: 4px;
        Text {
            text: root.b.label;
            width: 22px * root.scale;
            color: Theme.accent-text;
            font-weight: 700;
            font-size: 14px * root.scale;
            horizontal-alignment: left;
            vertical-alignment: top;
        }
        StyledText {
            text: root.b.rich;
            default-color: Theme.fg;
            default-font-size: 14px * root.scale;
        }
    }
    if root.b.kind == 4: HorizontalLayout {
        spacing: 10px;
        padding-left: 2px;
        Rectangle { width: 3px; border-radius: 2px; background: Theme.line-strong; }
        StyledText {
            text: root.b.rich;
            default-color: Theme.muted;
            default-font-size: 14px * root.scale;
        }
    }
    if root.b.kind == 5: Rectangle {
        background: Theme.field;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            padding-bottom: 8px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                padding-top: 6px;
                CopyChip { clicked => { root.copy-code(root.b.text); } }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.b.label == "" ? "код" : root.b.label;
                    color: Theme.subtle;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 2px;
                TextInput {
                    text: root.b.text;
                    read-only: true;
                    single-line: false;
                    wrap: TextWrap.word-wrap;
                    color: Theme.fg;
                    font-family: "Consolas";
                    font-size: 13px * root.scale;
                    selection-background-color: Theme.accent.with-alpha(0.35);
                    selection-foreground-color: Theme.fg;
                }
            }
        }
    }
    if root.b.kind == 6: Rectangle {
        background: Theme.accent-soft;
        border-radius: 10px;
        HorizontalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            Text {
                text: root.b.text;
                wrap: TextWrap.word-wrap;
                color: Theme.fg;
                font-family: "Cambria Math";
                font-size: 18px * root.scale;
                horizontal-alignment: center;
            }
        }
    }
}

// Pill under the short answer: opens and closes the detailed part.
component MoreToggle inherits Rectangle {
    in property <bool> expanded;
    callback clicked();
    height: 30px;
    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: 128px;
            border-radius: 15px;
            border-width: 1px;
            border-color: mta.has-hover ? Theme.accent : Theme.accent.with-alpha(0.45);
            background: mta.pressed ? Theme.accent.with-alpha(0.25) : mta.has-hover ? Theme.accent-soft : transparent;
            animate background, border-color { duration: 140ms; }
            HorizontalLayout {
                alignment: center;
                spacing: 7px;
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: root.expanded ? "Свернуть" : "Подробнее";
                    color: Theme.accent-text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Image {
                    source: @image-url("icons/chevron.svg");
                    width: 12px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.accent-text;
                    transform-rotation: root.expanded ? 180deg : 0deg;
                    animate transform-rotation { duration: 200ms; easing: ease-out; }
                }
            }
            mta := TipArea {
                tip: root.expanded ? "Оставить только короткий ответ" : "Показать полное объяснение";
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.clicked(); }
            }
        }
    }
}

component Thinking inherits HorizontalLayout {
    in property <length> size: 14px;
    in property <color> color: Theme.fg;
    spacing: 3px;
    alignment: start;
    Text { text: "Думаю"; color: root.color; font-size: root.size; vertical-alignment: center; }
    for i in [0, 1, 2]: Rectangle {
        width: root.size * 0.32;
        height: self.width;
        y: (parent.height - self.height) / 2 + root.size * 0.22;
        border-radius: self.width / 2;
        background: root.color;
        opacity: 0.25 + 0.75 * Math.abs(Math.sin(animation-tick() / 1ms * 0.18deg - i * 50deg));
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Nortex Assist";
    icon: @image-url("icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    preferred-width: 540px;
    preferred-height: 680px;
    min-width: root.overlay-view ? 1px : root.min-w;
    min-height: root.overlay-view ? 1px : root.min-h;

    in property <length> min-w: 280px;
    in property <length> min-h: 120px;
    in property <float> win-opacity: 1.0;
    // false for a moment before the window fades in
    in property <bool> appear-on: true;
    in property <bool> pinned: false;
    // compact, click-through presentation used by the game-overlay mode
    in property <bool> overlay-view: false;
    // overlay text size; the overlay window is exactly as big as its text (Rust reads ov-want-*)
    in property <length> ov-font: 16px;
    property <length> ov-pad-x: root.ov-font * 0.9;
    property <length> ov-pad-y: root.ov-font * 0.55;
    // "Думаю" plus the three dots
    property <length> ov-extra: root.thinking ? root.ov-font + 9px : 0px;
    property <length> ov-text-w: Math.min(ov-measure.preferred-width + root.ov-extra + 2px, root.ov-font * 28);
    out property <length> ov-want-w: root.ov-text-w + 2 * root.ov-pad-x + 2px;
    out property <length> ov-want-h: Math.min(ov-wrap.preferred-height, root.ov-font * 1.4 * 8) + 2 * root.ov-pad-y + 2px;

    // answer area
    in property <string> body-text;
    in property <string> question-text;
    in property <string> hint-text;
    in property <bool> busy;
    in property <bool> thinking;
    in property <string> toast-text;

    // update strip
    in property <bool> update-shown;
    in property <bool> update-busy;
    in property <string> update-text;
    in-out property <bool> auto-update: true;
    in property <string> version-text;
    in property <string> update-status;

    // toolbar
    in property <bool> nav-visible;
    in property <bool> answer-tools;
    in property <string> pos-text;
    in property <bool> prev-enabled;
    in property <bool> next-enabled;
    in property <bool> retry-enabled;
    in property <bool> copy-done;

    // composer
    in property <bool> composer-on;
    in property <string> composer-placeholder;
    in-out property <string> composer-text;
    in property <[ThumbItem]> thumbs;
    // files and folders attached with the paperclip
    in property <[FileItem]> files;

    // answer layout: blocks of the short part (and of the details when opened)
    in property <[BlockItem]> blocks;
    in property <bool> has-more: false;
    in property <bool> select-mode: false;
    in property <string> select-text;
    in property <bool> uninstall-open: false;
    in property <int> uninstall-left: 0;
    in property <bool> expanded: false;
    in property <float> text-scale: 1.0;
    in property <[int]> text-scales: [85, 100, 115, 130, 150, 175];
    in-out property <int> text-scale-index: 1;

    // history
    in property <bool> history-open;
    in property <[HistItem]> history-items;

    // settings
    in property <bool> settings-open;
    in-out property <int> provider-index;
    in-out property <int> model-index;
    in-out property <string> model-custom;
    in-out property <string> api-key;
    in property <string> api-key-label;
    in property <string> api-key-placeholder;
    in property <string> api-key-link-text;
    in-out property <float> opacity-pct: 100;
    in-out property <bool> autostart;
    in-out property <bool> history-enabled;
    in-out property <bool> overlay-mode;
    in-out property <bool> two-level: true;
    in property <[int]> overlay-fonts: [12, 14, 16, 18, 20, 24, 28, 32];
    in-out property <int> overlay-font-index: 2;
    in-out property <bool> show-tray: true;
    // own accent colour: palette state (hue in degrees, saturation and value 0..1) and the HEX field
    in-out property <bool> custom-open: false;
    in-out property <float> custom-h: 175;
    in-out property <float> custom-s: 0.6;
    in-out property <float> custom-v: 0.8;
    in-out property <string> custom-text;
    in-out property <int> shot-mode;
    in-out property <int> theme-index;
    in property <string> saved-text;
    in-out property <string> prompt-text;
    in property <string> key-check-text;
    in property <bool> key-check-ok: true;
    in property <[string]> hotkey-labels;
    in property <[string]> hotkey-values;
    in property <string> shot-hotkey: "Alt+W";
    in property <string> free-hotkey: "Alt+E";
    property <[string]> gemini-models: [
        "Gemini 3.5 Flash-Lite · быстрая, по умолчанию",
        "Gemini 3.8 Flash · новая, умнее",
        "Gemini 3.1 Pro · самая умная, медленнее",
        "Gemini 2.5 Flash · запасная",
        "Своя модель…",
    ];
    property <bool> panel-open: root.settings-open || root.history-open;
    property <bool> brand-shown: !root.busy && !((root.nav-visible || root.answer-tools) && !root.panel-open);

    callback submit(string);
    callback prev();
    callback next();
    callback retry();
    callback stop();
    callback update-now();
    callback update-dismiss();
    callback check-updates();
    callback check-key();
    callback prompt-preset(int);
    callback copy();
    callback toggle-more();
    callback toggle-select();
    callback copy-code(string);
    callback uninstall-ask();
    callback uninstall-cancel();
    callback uninstall-confirm();
    callback text-scale-changed(int);
    callback attach-pick(bool);
    callback remove-file(int);
    callback toggle-history();
    callback clear-history();
    callback toggle-settings();
    callback toggle-pin();
    callback hide-window();
    callback escape-pressed();
    callback drag-start();
    callback drag-move();
    callback resize-start();
    callback resize-move();
    callback paste-image() -> bool;
    callback remove-image(int);
    callback history-selected(int);
    callback provider-changed(int);
    callback opacity-changed(float);
    callback theme-picked(int);
    callback accent-picked(string);
    callback custom-color-picked(color);
    callback custom-text-edited(string);
    callback hotkey-key(int, string, bool, bool, bool, bool);
    callback hotkey-cancelled();
    callback reset-hotkeys();
    callback open-key-link();
    callback save-settings();
    callback exit-app();

    public function focus-input() { inp.focus(); }
    public function focus-root() { root-scope.focus(); }
    // std widgets (combo boxes, the prompt editor) follow the app theme, not the Windows one
    public function sync-palette() { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }

    root-scope := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape && (!root.pinned || root.busy)) {
                root.escape-pressed();
                return accept;
            }
            return reject;
        }
        capture-key-pressed(e) => {
            if (root.composer-on && !root.settings-open && e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "м" || e.text == "М")) {
                if (root.paste-image()) { return accept; }
            }
            return reject;
        }

        // the whole window fades in and rises a little when it opens
        Rectangle {
            y: root.appear-on ? 0px : 10px;
            height: parent.height;
            opacity: root.win-opacity * (root.appear-on ? 1 : 0);
            animate opacity { duration: root.appear-on ? 180ms : 0ms; easing: ease-out; }
            animate y { duration: root.appear-on ? 220ms : 0ms; easing: ease-out; }
            background: Theme.window;
            border-radius: root.overlay-view ? Math.min(18px, root.ov-font * 0.8) : 18px;
            border-width: 1px;
            border-color: Theme.line-strong;
            clip: true;

            VerticalLayout {
                // ---- toolbar ----
                Rectangle {
                    visible: !root.overlay-view;
                    height: root.overlay-view ? 0px : 44px;
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.drag-start();
                            }
                        }
                        moved => {
                            if (self.pressed) { root.drag-move(); }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        // app name while the left side of the toolbar has no buttons
                        if root.brand-shown: Brand { }
                        // answer tools only make sense while an answer is on screen
                        if root.nav-visible && !root.panel-open: IconButton { icon: @image-url("icons/left.svg"); tip: "Предыдущий ответ"; enabled: root.prev-enabled; clicked => { root.prev(); } }
                        if root.nav-visible && !root.panel-open: Text { text: root.pos-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; min-width: 34px; }
                        if root.nav-visible && !root.panel-open: IconButton { icon: @image-url("icons/right.svg"); tip: "Следующий ответ"; enabled: root.next-enabled; clicked => { root.next(); } }
                        if root.nav-visible && !root.panel-open: Rectangle { width: 8px; }
                        if root.busy: IconButton { icon: @image-url("icons/stop.svg"); tip: "Остановить ответ (Esc)"; active: true; clicked => { root.stop(); } }
                        if !root.busy && root.answer-tools && !root.panel-open: IconButton { icon: @image-url("icons/retry.svg"); tip: "Спросить заново (Alt+S).\nЕсли ответ уже пришёл, модель посчитает его\nневерным и попробует ответить по-другому"; enabled: root.retry-enabled; clicked => { root.retry(); } }
                        if !root.busy && root.answer-tools && !root.panel-open: IconButton {
                            icon: root.copy-done ? @image-url("icons/check.svg") : @image-url("icons/copy.svg");
                            tip: "Скопировать короткий ответ без оформления";
                            active: root.copy-done;
                            clicked => { root.copy(); }
                        }
                        if !root.busy && root.answer-tools && !root.panel-open: IconButton {
                            icon: @image-url("icons/select.svg");
                            tip: root.select-mode ? "Вернуть оформление" : "Выделить текст: ответ станет простым текстом,\nкоторый можно выделить мышью и скопировать по частям";
                            active: root.select-mode;
                            clicked => { root.toggle-select(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/history.svg"); tip: "История: прошлые вопросы и ответы.\nОтвет из истории можно уточнить"; active: root.history-open; clicked => { root.toggle-history(); } }
                        IconButton { icon: @image-url("icons/settings.svg"); tip: "Настройки"; active: root.settings-open; clicked => { root.toggle-settings(); } }
                        IconButton { icon: @image-url("icons/pin.svg"); tip: "Закрепить окно: оно не будет прятаться,\nкогда кликаешь в другое место или жмёшь Esc"; active: root.pinned; clicked => { root.toggle-pin(); } }
                        IconButton { icon: @image-url("icons/close.svg"); tip: "Спрятать окно (Esc) и остановить ответ.\nПрограмма остаётся в трее"; clicked => { root.hide-window(); } }
                    }
                    // waiting for the answer: a short accent stripe runs along the bottom edge
                    if root.busy: Rectangle {
                        x: 14px;
                        y: parent.height - 2px;
                        width: parent.width - 28px;
                        height: 2px;
                        clip: true;
                        Rectangle {
                            property <float> phase: Math.mod(animation-tick() / 1ms, 1400) / 1400;
                            width: parent.width * 0.28;
                            x: (parent.width + self.width) * self.phase - self.width;
                            height: 2px;
                            border-radius: 1px;
                            background: @linear-gradient(90deg, Theme.accent.with-alpha(0) 0%, Theme.accent 50%, Theme.accent.with-alpha(0) 100%);
                        }
                    }
                }

                // ---- "new version" strip: slides down ----
                if root.update-shown && !root.overlay-view && !root.settings-open: upd := Rectangle {
                    property <bool> shown: false;
                    Timer { interval: 16ms; running: !upd.shown; triggered => { upd.shown = true; } }
                    height: shown ? 40px : 0px;
                    animate height { duration: 220ms; easing: ease-out; }
                    clip: true;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 6px;
                        Rectangle {
                            background: Theme.accent-soft;
                            border-radius: 10px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 3px;
                                spacing: 4px;
                                Text {
                                    text: root.update-text;
                                    color: Theme.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: TextOverflow.elide;
                                }
                                if !root.update-busy: ActionButton {
                                    y: 2px;
                                    height: 30px;
                                    text: "Обновить";
                                    primary: true;
                                    tip: "Скачать и поставить новую версию.\nПрограмма перезапустится сама,\nнастройки и история сохранятся";
                                    clicked => { root.update-now(); }
                                }
                                if !root.update-busy: IconButton {
                                    y: 3px;
                                    icon: @image-url("icons/close.svg");
                                    tip: "Напомнить при следующем запуске";
                                    clicked => { root.update-dismiss(); }
                                }
                            }
                        }
                    }
                }

                // ---- answer in overlay presentation: just the text, centred ----
                if root.overlay-view: Rectangle {
                    vertical-stretch: 1;
                    if !root.thinking: Text {
                        x: root.ov-pad-x + 1px;
                        y: root.ov-pad-y + 1px;
                        width: parent.width - 2 * root.ov-pad-x - 2px;
                        height: parent.height - 2 * root.ov-pad-y - 2px;
                        text: root.body-text;
                        wrap: TextWrap.word-wrap;
                        overflow: TextOverflow.elide;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: Theme.fg;
                        font-size: root.ov-font;
                        font-weight: 500;
                    }
                    if root.thinking: HorizontalLayout {
                        alignment: center;
                        Thinking { size: root.ov-font; }
                    }
                }

                // ---- answer ----
                if !root.panel-open && !root.overlay-view: Panel {
                    vertical-stretch: 1;
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 4px;
                            padding-bottom: 12px;
                            spacing: 8px;
                            alignment: start;
                            if root.question-text != "": Text {
                                text: root.question-text;
                                wrap: TextWrap.word-wrap;
                                color: Theme.muted;
                                font-size: 12px;
                            }
                            if root.thinking: Thinking { }
                            if !root.thinking && root.select-mode: VerticalLayout {
                                spacing: 9px;
                                // plain text that can be selected with the mouse and copied part by part
                                FocusScope {
                                    capture-key-pressed(e) => {
                                        if (e.modifiers.control && !e.modifiers.alt) {
                                            if (e.text == "с" || e.text == "С") { sel.copy(); return accept; }
                                            if (e.text == "ф" || e.text == "Ф") { sel.select-all(); return accept; }
                                        }
                                        return reject;
                                    }
                                    VerticalLayout {
                                        sel := TextInput {
                                            text: root.select-text;
                                            read-only: true;
                                            single-line: false;
                                            wrap: TextWrap.word-wrap;
                                            color: Theme.fg;
                                            font-size: 14px * root.text-scale;
                                            selection-background-color: Theme.accent.with-alpha(0.35);
                                            selection-foreground-color: Theme.fg;
                                        }
                                    }
                                }
                                if root.has-more: MoreToggle {
                                    expanded: root.expanded;
                                    clicked => { root.toggle-more(); }
                                }
                            }
                            if !root.thinking && !root.select-mode: VerticalLayout {
                                spacing: 9px * root.text-scale;
                                for b[i] in root.blocks: AnswerBlock {
                                    b: b;
                                    first: i == 0;
                                    scale: root.text-scale;
                                    copy-code(t) => { root.copy-code(t); }
                                }
                                if root.has-more: MoreToggle {
                                    expanded: root.expanded;
                                    clicked => { root.toggle-more(); }
                                }
                            }
                            if root.hint-text != "": Text {
                                text: root.hint-text;
                                wrap: TextWrap.word-wrap;
                                color: Theme.subtle;
                                font-size: 12px;
                            }
                        }
                    }
                }

                // ---- history ----
                if root.history-open && !root.settings-open: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        padding-top: 4px;
                        spacing: 8px;
                        Text { text: "ПОСЛЕДНИЕ ДИАЛОГИ"; color: Theme.accent-text; font-size: 9px; font-weight: 700; }
                        HorizontalLayout {
                            Text { text: "История"; color: Theme.fg; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.history-items.length > 0: ConfirmButton {
                                text: "Очистить";
                                confirm-text: "Удалить всё?";
                                confirmed => { root.clear-history(); }
                            }
                        }
                        if root.history-items.length == 0: Text { text: "Пока пусто: здесь появятся вопросы и ответы."; color: Theme.muted; }
                        ListView {
                            vertical-stretch: 1;
                            for it[i] in root.history-items: Rectangle {
                                height: 54px;
                                background: hta.pressed ? Theme.line-strong : hta.has-hover ? Theme.line : transparent;
                                animate background { duration: 140ms; }
                                border-radius: 8px;
                                VerticalLayout {
                                    padding: 6px;
                                    padding-left: hta.has-hover ? 11px : 8px;
                                    animate padding-left { duration: 160ms; easing: ease-out; }
                                    spacing: 2px;
                                    Text { text: it.title; color: Theme.fg; font-size: 13px; font-weight: 600; overflow: TextOverflow.elide; }
                                    Text { text: it.sub; color: Theme.muted; font-size: 11px; overflow: TextOverflow.elide; }
                                }
                                hta := TipArea {
                                    tip: "Открыть ответ; его можно уточнить";
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.history-selected(i); }
                                }
                            }
                        }
                    }
                }

                // ---- settings ----
                if root.settings-open: Panel {
                    vertical-stretch: 1;
                    Rectangle {
                        height: 40px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text { text: "Настройки"; color: Theme.fg; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.version-text; color: Theme.subtle; font-size: 11px; vertical-alignment: center; }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-bottom: 8px;
                            spacing: 10px;

                            Card {
                                index: "01";
                                title: "Подключение";
                                Label { text: "Провайдер"; }
                                ComboBox {
                                    model: ["Google Gemini", "Groq"];
                                    current-index <=> root.provider-index;
                                    selected(v) => { root.provider-changed(self.current-index); }
                                }
                                if root.provider-index == 0: VerticalLayout {
                                    spacing: 8px;
                                    Label { text: "Модель Gemini"; }
                                    ComboBox {
                                        model: root.gemini-models;
                                        current-index <=> root.model-index;
                                    }
                                    if root.model-index == root.gemini-models.length - 1: Field {
                                        text <=> root.model-custom;
                                        placeholder: "Например: gemini-3.8-flash";
                                    }
                                }
                                if root.provider-index == 1: VerticalLayout {
                                    spacing: 8px;
                                    Label { text: "Модель Groq"; }
                                    ComboBox { model: ["Qwen 3.8 · 27B"]; current-index: 0; }
                                    Label { text: "Qwen 3.8 27B понимает текст и картинки."; font-size: 10px; }
                                }
                                Label { text: root.api-key-label; }
                                Field {
                                    password: true;
                                    text <=> root.api-key;
                                    placeholder: root.api-key-placeholder;
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: start;
                                    LinkText { text: root.api-key-link-text; tip: "Там можно бесплатно получить ключ"; clicked => { root.open-key-link(); } }
                                    LinkText { text: "Проверить ключ"; tip: "Проверить, что ключ рабочий\nи выбранная модель доступна"; clicked => { root.check-key(); } }
                                }
                                if root.key-check-text != "": Label {
                                    text: root.key-check-text;
                                    color: root.key-check-ok ? Theme.muted : Theme.danger;
                                    wrap: TextWrap.word-wrap;
                                }
                            }

                            Card {
                                index: "02";
                                title: "Внешний вид";
                                Label { text: "Тема"; }
                                Segmented {
                                    items: ["Тёмная", "Светлая"];
                                    current <=> root.theme-index;
                                    picked(i) => { root.theme-picked(i); }
                                }
                                Label { text: "Прозрачность окна: " + Math.round(root.opacity-pct) + "%"; }
                                OpacitySlider {
                                    value <=> root.opacity-pct;
                                    changed(v) => { root.opacity-changed(v); }
                                }
                                Label { text: "Акцентный цвет"; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for name in ["green", "pink", "blue", "red", "orange", "violet"]: Rectangle {
                                        property <bool> picked: Theme.accent-name == name;
                                        width: 30px;
                                        height: 30px;
                                        Rectangle {
                                            // the chosen colour gets a ring, the hovered one grows a little
                                            width: dta.has-hover || parent.picked ? 26px : 22px;
                                            height: self.width;
                                            border-radius: self.width / 2;
                                            background: Theme.accent-of(name, Theme.dark);
                                            border-width: parent.picked ? 2px : 0px;
                                            border-color: Theme.fg;
                                            animate width { duration: 150ms; easing: ease-out; }
                                            animate border-width { duration: 150ms; }
                                        }
                                        dta := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.custom-open = false; root.accent-picked(name); }
                                        }
                                    }
                                    // own colour: a rainbow dot that opens the palette
                                    Rectangle {
                                        property <bool> picked: Theme.accent-name == "custom";
                                        width: 30px;
                                        height: 30px;
                                        Rectangle {
                                            width: cta.has-hover || parent.picked || root.custom-open ? 26px : 22px;
                                            height: self.width;
                                            border-radius: self.width / 2;
                                            border-width: parent.picked ? 2px : 0px;
                                            border-color: Theme.fg;
                                            animate width { duration: 150ms; easing: ease-out; }
                                            animate border-width { duration: 150ms; }
                                            // the rainbow is a picture: gradients do not get round corners
                                            Image { source: @image-url("icons/rainbow.svg"); width: parent.width; height: parent.height; }
                                            // the chosen own colour sits in the middle
                                            if parent.picked: Rectangle {
                                                width: 10px;
                                                height: 10px;
                                                border-radius: 5px;
                                                background: Theme.custom-accent;
                                                border-width: 1px;
                                                border-color: #00000040;
                                            }
                                        }
                                        cta := TipArea {
                                            tip: "Свой цвет: палитра, HEX или RGB";
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.custom-open = !root.custom-open;
                                                if (root.custom-open) { root.accent-picked("custom"); }
                                            }
                                        }
                                    }
                                }
                                if root.custom-open: AccentPicker {
                                    h <=> root.custom-h;
                                    s <=> root.custom-s;
                                    v <=> root.custom-v;
                                    text <=> root.custom-text;
                                    picked(c) => { root.custom-color-picked(c); }
                                    text-edited(t) => { root.custom-text-edited(t); }
                                }
                                Label { text: "Размер текста ответа"; }
                                StepSlider {
                                    steps: root.text-scales;
                                    unit: " %";
                                    index <=> root.text-scale-index;
                                    changed(i) => { root.text-scale-changed(i); }
                                }
                                Check { label: "Поверх окон"; checked <=> root.overlay-mode; }
                                Label {
                                    text: "Короткий ответ в маленьком окне, которое не забирает фокус и пропускает клики. Работает над играми (в окне или без рамки), видео и лекциями.";
                                    font-size: 10px;
                                    wrap: TextWrap.word-wrap;
                                }
                                if root.overlay-mode: Label { text: "Размер текста в этом окне. Оно само подстраивается под ответ."; wrap: TextWrap.word-wrap; }
                                if root.overlay-mode: StepSlider {
                                    steps: root.overlay-fonts;
                                    index <=> root.overlay-font-index;
                                }
                                if root.overlay-mode: HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    Label { text: "Так будет выглядеть:"; vertical-alignment: center; }
                                    OverlaySample { text: "B"; font: root.overlay-fonts[root.overlay-font-index] * 1px; }
                                    OverlaySample { text: "Канберра"; font: root.overlay-fonts[root.overlay-font-index] * 1px; }
                                }
                            }

                            Card {
                                index: "03";
                                title: "Ответы";
                                Label { text: "Заготовки"; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    ActionButton { text: "Только ответ"; tip: "Короткий ответ без объяснений (как раньше)"; clicked => { root.prompt-preset(0); } }
                                    ActionButton { text: "С пояснением"; tip: "Ответ и пара предложений, почему так"; clicked => { root.prompt-preset(1); } }
                                    ActionButton { text: "Подробно"; tip: "Подробное решение по шагам.\nМодель думает дольше"; clicked => { root.prompt-preset(2); } }
                                }
                                Label { text: "Промпт, который получает нейросеть (можно переписать своими словами, в том числе по-русски)"; wrap: TextWrap.word-wrap; }
                                FocusScope {
                                    capture-key-pressed(e) => {
                                        if (e.modifiers.control && !e.modifiers.alt) {
                                            if (e.text == "м" || e.text == "М") { pe.paste(); return accept; }
                                            if (e.text == "ф" || e.text == "Ф") { pe.select-all(); return accept; }
                                            if (e.text == "с" || e.text == "С") { pe.copy(); return accept; }
                                            if (e.text == "ч" || e.text == "Ч") { pe.cut(); return accept; }
                                        }
                                        return reject;
                                    }
                                    VerticalLayout {
                                        pe := TextEdit {
                                            height: 110px;
                                            font-size: 12px;
                                            wrap: TextWrap.word-wrap;
                                            text <=> root.prompt-text;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Label {
                                        text: "Изменённый промпт действует и в режиме «Поверх окон».";
                                        font-size: 10px;
                                        wrap: TextWrap.word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    ActionButton { text: "Сбросить"; tip: "Вернуть встроенный промпт «Только ответ»"; clicked => { root.prompt-preset(0); } }
                                }
                                Check { label: "Короткий ответ, подробности по кнопке"; checked <=> root.two-level; }
                                Label {
                                    text: "Сначала короткий ответ, а объяснение раскрывается кнопкой «Подробнее». Выключите, чтобы получать ответ целиком.";
                                    font-size: 10px;
                                    wrap: TextWrap.word-wrap;
                                }
                            }

                            Card {
                                index: "04";
                                title: "Поведение";
                                Check { label: "Запускать вместе с Windows"; checked <=> root.autostart; }
                                Check { label: "Отображать приложение в трее"; checked <=> root.show-tray; }
                                if !root.show-tray: Label {
                                    text: "Без значка в трее окно открывается горячими клавишами (" + root.free-hotkey + "), а выйти можно кнопкой «Закрыть программу» внизу настроек.";
                                    font-size: 10px;
                                    wrap: TextWrap.word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Check { label: "Сохранять историю (зашифрованно)"; checked <=> root.history-enabled; horizontal-stretch: 1; }
                                    ConfirmButton { height: 26px; text: "Очистить историю"; confirm-text: "Удалить всю историю?"; confirmed => { root.clear-history(); } }
                                }
                                Label { text: "Скриншот (" + root.shot-hotkey + ")"; }
                                Segmented {
                                    items: ["Выделить область", "Весь экран", "Ножницы Windows"];
                                    tips: [
                                        "Экран замирает, обведи нужное мышью.\nКлик без выделения — весь экран",
                                        "Сразу весь монитор под курсором, без выделения",
                                        "Встроенный инструмент Windows (как раньше)",
                                    ];
                                    current <=> root.shot-mode;
                                }
                                Label {
                                    text: root.shot-mode == 0 ? "Экран замирает, обведи нужное мышью. Клик без выделения — весь экран, Esc — отмена. До 4 снимков подряд."
                                        : root.shot-mode == 1 ? "Снимается весь монитор под курсором, сразу открывается окно с вопросом. До 4 снимков подряд."
                                        : "Открываются «Ножницы» Windows; после выделения снимок попадает в окно с вопросом.";
                                    font-size: 10px;
                                    wrap: TextWrap.word-wrap;
                                }
                            }

                            Card {
                                index: "05";
                                title: "Горячие клавиши";
                                for label[i] in root.hotkey-labels: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: label; color: Theme.fg; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                    HotkeyField {
                                        text: root.hotkey-values[i];
                                        key(t, c, a, s, m) => { root.hotkey-key(i, t, c, a, s, m); }
                                        cancelled => { root.hotkey-cancelled(); }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    ActionButton { text: "По умолчанию"; tip: "Вернуть Alt+Q, Alt+W, Alt+E, Alt+S"; clicked => { root.reset-hotkeys(); } }
                                }
                            }

                            Card {
                                index: "06";
                                title: "Обновления";
                                HorizontalLayout {
                                    spacing: 8px;
                                    Check { label: "Проверять обновления автоматически"; checked <=> root.auto-update; horizontal-stretch: 1; }
                                    LinkText { text: "Проверить сейчас"; vertical-alignment: center; tip: "Спросить у GitHub, есть ли новая версия"; clicked => { root.check-updates(); } }
                                }
                                if root.update-status != "": Label { text: root.update-status; wrap: TextWrap.word-wrap; }
                            }
                        }
                    }
                    Rectangle {
                        height: 52px;
                        HorizontalLayout {
                            padding: 10px;
                            padding-left: 12px;
                            spacing: 8px;
                            IconButton {
                                y: 1px;
                                icon: @image-url("icons/trash.svg");
                                tip: "Удалить программу.\nПопросит подтвердить, кнопка включится через 5 секунд";
                                clicked => { root.uninstall-ask(); }
                            }
                            Text {
                                text: root.saved-text;
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: TextOverflow.elide;
                            }
                            ActionButton { text: "Закрыть программу"; tip: "Сохранить настройки и полностью выйти.\nГорячие клавиши перестанут работать"; clicked => { root.exit-app(); } }
                            ActionButton { text: "Готово"; tip: "Сохранить настройки и вернуться к ответу"; primary: true; clicked => { root.save-settings(); } }
                        }
                    }
                }

                // ---- composer: grows in from the bottom ----
                Rectangle {
                    property <bool> shown: root.composer-on && !root.panel-open && !root.overlay-view;
                    visible: shown;
                    height: shown ? 58px + (root.thumbs.length > 0 ? 76px : 0px) + (root.files.length > 0 ? 36px : 0px) : 0px;
                    animate height { duration: 180ms; easing: ease-out; }
                    clip: true;
                    VerticalLayout {
                        padding: 10px;
                        padding-top: 4px;
                        spacing: 8px;
                        alignment: end;
                        if root.thumbs.length > 0: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for t[i] in root.thumbs: thumb := Rectangle {
                                property <bool> shown: false;
                                Timer { interval: 16ms; running: !thumb.shown; triggered => { thumb.shown = true; } }
                                width: 64px;
                                height: 64px;
                                opacity: shown ? 1 : 0;
                                animate opacity { duration: 200ms; easing: ease-out; }
                                Rectangle {
                                    // pops in from slightly smaller
                                    width: parent.shown ? parent.width : parent.width - 10px;
                                    height: self.width;
                                    animate width { duration: 220ms; easing: ease-out; }
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: Theme.line-strong;
                                    clip: true;
                                    Image { source: t.img; image-fit: ImageFit.cover; width: parent.width; height: parent.height; }
                                    // hover: darken and show a cross, since a click removes the picture
                                    Rectangle {
                                        background: #000000;
                                        opacity: tta.has-hover ? 0.55 : 0;
                                        animate opacity { duration: 140ms; }
                                    }
                                    Image {
                                        source: @image-url("icons/close.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: #ffffff;
                                        opacity: tta.has-hover ? 1 : 0;
                                        animate opacity { duration: 140ms; }
                                    }
                                }
                                tta := TipArea {
                                    tip: "Убрать эту картинку";
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.remove-image(i); }
                                }
                            }
                        }
                        if root.files.length > 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            height: 28px;
                            for f[i] in root.files: Rectangle {
                                width: min(fchip.preferred-width + 8px, 190px);
                                height: 28px;
                                border-radius: 8px;
                                background: Theme.accent-soft;
                                fchip := HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Image {
                                        source: f.folder ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                                        width: 13px;
                                        height: 13px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: Theme.accent-text;
                                    }
                                    Text { text: f.name; color: Theme.fg; font-size: 11px; vertical-alignment: center; overflow: TextOverflow.elide; }
                                    if f.info != "": Text { text: f.info; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                                    Image {
                                        source: @image-url("icons/close.svg");
                                        width: 11px;
                                        height: 11px;
                                        y: (parent.height - self.height) / 2;
                                        colorize: fca.has-hover ? Theme.fg : Theme.muted;
                                    }
                                }
                                fca := TipArea {
                                    tip: "Убрать из вопроса";
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.remove-file(i); }
                                }
                            }
                        }
                        Rectangle {
                            height: 44px;
                            background: Theme.field;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: inp.has-focus ? Theme.accent : Theme.line;
                            animate border-color { duration: 160ms; }
                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;
                                padding-top: 7px;
                                padding-bottom: 7px;
                                spacing: 6px;
                                Rectangle {
                                    width: 30px;
                                    border-radius: 9px;
                                    background: cla.pressed ? Theme.line-strong : cla.has-hover ? Theme.line : transparent;
                                    animate background { duration: 140ms; }
                                    Image {
                                        source: @image-url("icons/clip.svg");
                                        width: 16px;
                                        height: 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        colorize: cla.has-hover ? Theme.accent-text : Theme.muted;
                                        animate colorize { duration: 140ms; }
                                    }
                                    cla := TipArea {
                                        tip: "Прикрепить файлы.\nТекст из них попадёт в вопрос";
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.attach-pick(false); }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    FocusScope {
                                        capture-key-pressed(e) => {
                                            if (e.modifiers.control && !e.modifiers.alt) {
                                                if (e.text == "м" || e.text == "М") { inp.paste(); return accept; }
                                                if (e.text == "ф" || e.text == "Ф") { inp.select-all(); return accept; }
                                                if (e.text == "с" || e.text == "С") { inp.copy(); return accept; }
                                                if (e.text == "ч" || e.text == "Ч") { inp.cut(); return accept; }
                                            }
                                            if (e.modifiers.shift && e.text == Key.Insert) { inp.paste(); return accept; }
                                            return reject;
                                        }
                                        inp := TextInput {
                                            y: 0;
                                            width: parent.width;
                                            height: parent.height;
                                            vertical-alignment: center;
                                            text <=> root.composer-text;
                                            color: Theme.fg;
                                            font-size: 14px;
                                            single-line: true;
                                            accepted => { root.submit(self.text); }
                                        }
                                    }
                                    if root.composer-text == "": Text {
                                        y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        text: root.composer-placeholder;
                                        color: Theme.subtle;
                                        font-size: 14px;
                                        overflow: TextOverflow.elide;
                                    }
                                }
                                Rectangle {
                                    width: 30px;
                                    // grey at rest, lights up with the accent colour under the pointer
                                    background: sta.pressed ? Theme.accent.darker(0.2) : sta.has-hover ? Theme.accent : Theme.line-strong;
                                    animate background { duration: 140ms; }
                                    border-radius: 9px;
                                    Image {
                                        source: @image-url("icons/send.svg");
                                        width: 14px;
                                        height: 14px;
                                        // the arrow nudges forward under the pointer
                                        x: (parent.width - self.width) / 2 + (sta.has-hover ? 2px : 0px);
                                        y: (parent.height - self.height) / 2 - (sta.has-hover ? 1px : 0px);
                                        animate x, y { duration: 160ms; easing: ease-out; }
                                        colorize: sta.has-hover || sta.pressed ? Theme.accent-ink : Theme.muted;
                                        animate colorize { duration: 140ms; }
                                    }
                                    sta := TipArea {
                                        tip: "Отправить (Enter).\nCtrl+V в поле вставляет картинку из буфера";
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.submit(root.composer-text); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // invisible copies of the overlay text, used only to measure it
            ov-measure := Text {
                visible: false;
                text: root.thinking ? "Думаю" : root.body-text;
                font-size: root.ov-font;
                font-weight: 500;
            }
            ov-wrap := Text {
                visible: false;
                width: root.ov-text-w;
                text: root.thinking ? "Думаю" : root.body-text;
                wrap: TextWrap.word-wrap;
                font-size: root.ov-font;
                font-weight: 500;
            }

            // resize grip
            Rectangle {
                visible: !root.overlay-view;
                x: parent.width - 20px;
                y: parent.height - 20px;
                width: 20px;
                height: 20px;
                Path {
                    x: 6px;
                    y: 6px;
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 9 1 L 1 9 M 9 5 L 5 9";
                    stroke: gta.has-hover || gta.pressed ? Theme.accent-text : Theme.subtle;
                    stroke-width: 1.2px;
                }
                gta := TipArea {
                    tip: "Потяни, чтобы изменить размер окна";
                    mouse-cursor: MouseCursor.nwse-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.resize-start();
                        }
                    }
                    moved => {
                        if (self.pressed) { root.resize-move(); }
                    }
                }
            }

            // uninstall confirmation: the red button wakes up after five seconds
            if root.uninstall-open && !root.overlay-view: Rectangle {
                background: #000000b8;
                TouchArea { }
                Rectangle {
                    width: min(parent.width - 40px, 360px);
                    height: ucol.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: Theme.raised;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                    ucol := VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text { text: "Удалить Nortex Assist?"; color: Theme.fg; font-size: 16px; font-weight: 700; }
                        Text {
                            text: "Программа, её настройки, ключи API и история будут удалены с этого компьютера. Отменить это нельзя.";
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: TextWrap.word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 6px;
                            alignment: end;
                            ActionButton { text: "Отмена"; primary: true; clicked => { root.uninstall-cancel(); } }
                            Rectangle {
                                height: 30px;
                                min-width: 110px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.danger;
                                background: root.uninstall-left == 0 ? (uda.pressed ? Theme.danger.darker(0.2) : uda.has-hover ? Theme.danger.brighter(0.1) : Theme.danger) : transparent;
                                animate background { duration: 140ms; }
                                Text {
                                    text: root.uninstall-left > 0 ? "Удалить (" + root.uninstall-left + ")" : "Удалить";
                                    color: root.uninstall-left == 0 ? #1c0d0c : Theme.danger.with-alpha(0.7);
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                uda := TouchArea {
                                    enabled: root.uninstall-left == 0;
                                    mouse-cursor: root.uninstall-left == 0 ? MouseCursor.pointer : MouseCursor.default;
                                    clicked => { root.uninstall-confirm(); }
                                }
                            }
                        }
                    }
                }
            }

            // short notice at the bottom ("История очищена", warnings): slides up and fades
            if root.toast-text != "" && !root.overlay-view: toast := Rectangle {
                property <bool> shown: false;
                Timer { interval: 16ms; running: !toast.shown; triggered => { toast.shown = true; } }
                width: min(toast-label.preferred-width + 28px, parent.width - 32px);
                height: toast-label.preferred-height + 16px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - (root.settings-open ? 64px : root.composer-on && !root.panel-open ? 74px : 18px) + (shown ? 0px : 10px);
                opacity: shown ? 1 : 0;
                animate y, opacity { duration: 200ms; easing: ease-out; }
                background: Theme.raised;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line-strong;
                drop-shadow-blur: 14px;
                drop-shadow-color: #00000060;
                toast-label := Text {
                    x: 14px;
                    y: 8px;
                    width: parent.width - 28px;
                    text: root.toast-text;
                    color: Theme.fg;
                    font-size: 12px;
                    overflow: TextOverflow.elide;
                }
            }

            // tooltip: last child, so it is drawn above everything else
            if Tip.text != "" && !root.overlay-view: tipbox := Rectangle {
                property <bool> shown: false;
                Timer { interval: 16ms; running: !tipbox.shown; triggered => { tipbox.shown = true; } }
                width: min(tip-text.preferred-width + 18px, parent.width - 16px);
                height: tip-text.preferred-height + 12px;
                x: max(8px, min(Tip.x, parent.width - self.width - 8px));
                // below the control, or above it when there is no room at the bottom
                property <length> below: Tip.y + Tip.anchor-h + 6px;
                property <bool> flip: self.below + self.height > parent.height - 4px;
                y: (self.flip ? max(4px, Tip.y - self.height - 6px) : self.below) + (shown ? 0px : (self.flip ? 4px : -4px));
                opacity: shown ? 1 : 0;
                animate opacity, y { duration: 150ms; easing: ease-out; }
                background: Theme.raised;
                border-radius: 7px;
                border-width: 1px;
                border-color: Theme.line-strong;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000050;
                tip-text := Text {
                    x: 9px;
                    y: 6px;
                    text: Tip.text;
                    color: Theme.fg;
                    font-size: 11px;
                }
            }
        }
    }
}

// Full-screen area picker: the frozen screenshot of the monitor, the user drags a rectangle over it.
export component SnipWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: #000000;
    title: "Nortex Assist — снимок области";
    default-font-family: "Segoe UI";
    forward-focus: fs;

    in property <image> shot;
    in property <float> img-w: 1;
    in property <float> img-h: 1;
    // the selection as fractions of the screen (x, y, width, height); a plain click gives the whole screen
    callback done(float, float, float, float);
    callback cancelled();
    public function grab-focus() { fs.focus(); }

    property <length> ax;
    property <length> ay;
    property <length> bx;
    property <length> by;
    property <bool> dragging: false;
    property <bool> started: false;
    property <length> sx: min(root.ax, root.bx);
    property <length> sy: min(root.ay, root.by);
    property <length> sw: abs(root.bx - root.ax);
    property <length> sh: abs(root.by - root.ay);
    property <bool> intro: false;
    property <color> dim: #000000a6;
    Timer { interval: 16ms; running: !root.intro; triggered => { root.intro = true; } }

    Image { width: parent.width; height: parent.height; source: root.shot; image-fit: fill; }

    // before a selection: the whole screen dims in; during it, four bands leave the selection bright
    // dimmed from the first frame, so the screen never shows a bright frozen copy first
    if !root.started: Rectangle { background: root.dim; }
    if root.started: Rectangle { x: 0; y: 0; width: parent.width; height: root.sy; background: root.dim; }
    if root.started: Rectangle { x: 0; y: root.sy + root.sh; width: parent.width; height: parent.height - root.sy - root.sh; background: root.dim; }
    if root.started: Rectangle { x: 0; y: root.sy; width: root.sx; height: root.sh; background: root.dim; }
    if root.started: Rectangle { x: root.sx + root.sw; y: root.sy; width: parent.width - root.sx - root.sw; height: root.sh; background: root.dim; }
    if root.started: Rectangle {
        x: root.sx - 1px;
        y: root.sy - 1px;
        width: root.sw + 2px;
        height: root.sh + 2px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 2px;
    }
    // crosshair lines that follow the pointer before dragging
    if !root.dragging && ta.has-hover: Rectangle { x: ta.mouse-x; y: 0; width: 1px; height: parent.height; background: Theme.accent.with-alpha(0.55); }
    if !root.dragging && ta.has-hover: Rectangle { x: 0; y: ta.mouse-y; width: parent.width; height: 1px; background: Theme.accent.with-alpha(0.55); }

    // size of the selection in real pixels
    if root.started: Rectangle {
        x: min(root.sx, parent.width - self.width - 4px);
        y: root.sy > 34px ? root.sy - 30px : min(root.sy + root.sh + 6px, parent.height - self.height - 4px);
        width: size-label.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: #000000c8;
        size-label := Text {
            text: Math.round(root.sw / root.width * root.img-w) + " × " + Math.round(root.sh / root.height * root.img-h);
            color: #ffffff;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // hint at the top; slides down when the picker opens, fades away once the user starts selecting
    Rectangle {
        width: hint.preferred-width + 32px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: root.intro ? 28px : 10px;
        opacity: root.started ? 0 : (root.intro ? 1 : 0);
        animate y { duration: 260ms; easing: ease-out; }
        animate opacity { duration: 200ms; }
        border-radius: 18px;
        background: #121416e6;
        border-width: 1px;
        border-color: #ffffff22;
        hint := Text {
            text: "Выдели область мышью   ·   клик — весь экран   ·   Esc — отмена";
            color: #f0f2ec;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: MouseCursor.crosshair;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.cancelled();
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.ax = self.mouse-x;
                root.ay = self.mouse-y;
                root.bx = root.ax;
                root.by = root.ay;
                root.dragging = true;
                root.started = false;
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                if (root.sw < 6px || root.sh < 6px) {
                    root.done(0, 0, 1, 1);
                } else {
                    root.done(root.sx / root.width, root.sy / root.height, root.sw / root.width, root.sh / root.height);
                }
            }
        }
        moved => {
            if (root.dragging) {
                root.bx = clamp(self.mouse-x, 0px, root.width);
                root.by = clamp(self.mouse-y, 0px, root.height);
                if (abs(root.bx - root.ax) > 3px || abs(root.by - root.ay) > 3px) {
                    root.started = true;
                }
            }
        }
    }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            if (e.text == Key.Return) {
                root.done(0, 0, 1, 1);
                return accept;
            }
            return reject;
        }
    }
}
